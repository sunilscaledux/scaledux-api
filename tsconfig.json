{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@config/*": ["src/config/*"],
      "@constants/*": ["src/constants/*"],
      "@module/*": ["src/module/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@middleware/*": ["src/middleware/*"],
      "@services/*": ["src/services/*"],
      "@queues/*": ["src/queues/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "*.d.ts", "src/services/redisService.ts"],
  "exclude": ["node_modules"],
  "ts-node": {
    "files": true
  }
}
