datasource db {
    provider = "postgresql"
    url      = env("POSTGRES_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id                Int       @id @default(autoincrement())
    FirstName         String
    LastName          String?
    email             String?   @unique
    phone             String?   @unique
    email_verified_at DateTime?
    phone_verified_at DateTime?
    password          String?   
    status            Int       @default(1)
    created_at        DateTime  @default(now())
    updated_at        DateTime  @updatedAt
    notification      Boolean   @default(false)
    terms             Boolean   @default(true)
    
    googleId          String?   @unique
    linkedinId        String?   @unique
    profileImage      String?
    provider          String?  

    otps Otp[]

    @@index([email, phone])
    @@index([LastName, FirstName, email])
    @@index([googleId])
    @@index([linkedinId])
    @@map("users")
}

model Otp {
    id         Int      @id @default(autoincrement())
    user_id    Int?
    email      String?
    phone      String?
    otp_code   String
    otp_type   OtpType
    expires_at DateTime
    verified   Boolean  @default(false)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relations
    user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@index([email, otp_type, verified])
    @@index([phone, otp_type, verified])
    @@index([expires_at])
    @@map("otps")
}

enum OtpType {
    REGISTRATION_VERIFICATION
    LOGIN_VERIFICATION
    FORGOT_PASSWORD_VERIFICATION
}
