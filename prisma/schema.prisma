datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int       @id @default(autoincrement())
  FirstName              String
  LastName              String?  
  email             String    @unique
  phone             String?    @unique 
  email_verified_at DateTime? 
  phone_verified_at DateTime?
  password          String
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
 
 @@index([email, phone])
 @@index([LastName, FirstName, email])

  @@map("users")
}
