// Bank information for payouts. One per user per entity_type (INDIVIDUAL / AGENCY).
model BankInformation {
  id                    Int      @id @default(autoincrement())
  unique_id             String   @unique @default(cuid())
  user_id               Int
  type                  String   @db.VarChar(20)   @default("bank_account")
  entity_type           String   @db.VarChar(20)   @default("INDIVIDUAL")
  display_label         String   @db.VarChar(255)
  bank_name             String?  @db.VarChar(100)
  account_holder_name   String?  @db.VarChar(200)
  account_number        String?  @db.VarChar(34)
  account_number_last4  String?  @db.VarChar(4)
  ifsc                  String?  @db.VarChar(11)
  razorpay_fund_account_id String? @db.VarChar(64)
  /** Email used for Razorpay linked account; can differ from ScaleDux registered email; must be unique across all records. */
  razorpay_email           String?  @unique @db.VarChar(255)
  /** Razorpay Route linked account activation status: needs_clarification, under_review, activated, suspended, etc. */
  razorpay_activation_status String? @db.VarChar(30)
  /** Razorpay Route product id (acc_prd_xxx); activation_status is read from this product, not the account. */
  razorpay_product_id      String?  @db.VarChar(64)
  /** pending = verification in process; verified = razorpay_fund_account_id set; failed = verification failed */
  verification_status   String   @db.VarChar(20)   @default("pending")
  /** Reason for failure when verification_status = failed; shown to user so they can fix and resubmit. */
  verification_failure_reason String? @db.VarChar(500)
  verified_at           DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  withdrawal_requests    WithdrawalRequest[]

  @@unique([user_id, entity_type])
  @@index([user_id])
  @@index([unique_id])
  @@index([verification_status])
  @@map("scd_bank_information")
}

// Withdrawal request: one row per "request withdraw" for a payment; cron processes these (status: pending → completed/failed)
model WithdrawalRequest {
  id                     Int       @id @default(autoincrement())
  user_id                Int
  withdrawal_method_id   Int
  billing_transaction_id Int       @unique
  status                 WithdrawalRequestStatus
  withdrawal_trigger_at  DateTime  @default(now())
  processed_at           DateTime?
  error_message          String?   @db.VarChar(500)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  withdrawal_method     BankInformation       @relation(fields: [withdrawal_method_id], references: [id], onDelete: Restrict)
  billing_transaction   BillingTransaction   @relation(fields: [billing_transaction_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([withdrawal_trigger_at])
  @@map("scd_withdrawal_requests")
}

model TaxInformation {
  id             Int      @id @default(autoincrement())
  user_id        Int
  entity_type    String   @default("INDIVIDUAL") @db.VarChar(20) // INDIVIDUAL | AGENCY
  tax_residence  Json
  name           String?  @db.VarChar(200)
  pan_number     String?  @db.VarChar(10)
  has_gstin      Boolean  @default(false)
  gstin          String?  @db.VarChar(15)
  gstin_status   String?  @default("PENDING") @db.VarChar(20) // PENDING | VERIFIED | FAILED
  gstin_verified_at    DateTime?
  gstin_failure_reason String?  @db.VarChar(500)
  gstin_api_response   Json?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, entity_type])
  @@index([user_id])
  @@map("scd_tax_information")
}

// Billing transaction type and status enums (use constants from @constants/status in app code)
enum BillingTransactionType {
  payment
  refund
  withdrawal
}

enum BillingTransactionStatus {
  pending
  completed
  failed
  payment_processed
}

/** Payer (from_id) view status; receiver (to_id) view status; admin internal status. */
enum BillingTransactionSenderStatus {
  funded
  completed
  released
}

enum BillingTransactionReceiverStatus {
  pending
  completed
  released
  withdraw_in_process
  paid_out
  payment_processed
}

enum BillingTransactionAdminStatus {
  loaded
  sent_to_freelancer
  success
}

enum WithdrawalRequestStatus {
  pending
  processing
  completed
  failed
}

model BillingTransaction {
  id              Int      @id @default(autoincrement())
  unique_id       String   @unique @default(cuid()) @db.VarChar(26)

  // WHO triggered the action
  actor_type      String   @db.VarChar(50) // User, Admin, System
  actor_id        Int

  // MONEY FROM
  from_type       String   @db.VarChar(50) // User, Platform, Wallet
  from_id         Int

  // MONEY TO
  to_type         String   @db.VarChar(50) // User, Platform, Freelancer
  to_id           Int

  // WHAT the transaction is about
  subject_type    String   @db.VarChar(50) // Project, ServicePackage, Subscription
  subject_id      Int

  /** When subject is Proposal payment, link to the milestone (null for non-milestone payments). */
  milestone_id    Int?

  amount          Decimal  @db.Decimal(10, 2)
  /** What payer paid (base + app fee + GST). Set for payment type. */
  payer_amount    Decimal? @db.Decimal(10, 2)
  /** What receiver gets (base - service fee - GST). Set for payment type. */
  receiver_amount Decimal? @db.Decimal(10, 2)
  currency_id     Int      @default(1)

  type            BillingTransactionType
  status          BillingTransactionStatus

  /** Payer (from_id) view status; UI shows this when current user is payer */
  sender_status   BillingTransactionSenderStatus?
  /** Receiver (to_id) view status; UI shows this when current user is receiver */
  receiver_status BillingTransactionReceiverStatus?
  /** Admin-only internal status */
  admin_status    BillingTransactionAdminStatus?

  description     String   @db.Text
  invoice_url     String?  @db.VarChar(500) // deprecated: use Invoice table
  meta            Json?    // deprecated: store in Invoice.meta; kept for backward compat

  // Fee breakdown (new billing system)
  platform_fee_amount  Decimal? @db.Decimal(10, 2)
  platform_fee_gst     Decimal? @db.Decimal(10, 2)
  commission_amount    Decimal? @db.Decimal(10, 2)
  commission_gst       Decimal? @db.Decimal(10, 2)
  processing_fee_amount Decimal? @db.Decimal(10, 2)
  processing_fee_gst   Decimal? @db.Decimal(10, 2)
  tcs_amount           Decimal? @db.Decimal(10, 2)
  // Razorpay Route
  razorpay_transfer_id String?  @db.VarChar(50)
  on_hold              Boolean  @default(false)
  /** When the freelancer sent Invoice A; used for 24h auto-approve countdown. */
  invoice_sent_at      DateTime?

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  /** Payer's invoice (founder side); set when invoice is generated for payer */
  payer_invoice_id   Int?    @unique
  /** Receiver's invoice (freelancer side); set when invoice is generated for receiver */
  receiver_invoice_id Int?   @unique
  /** Invoice A (freelancer→client service invoice) */
  invoice_a_id       Int?    @unique

  currency Currency @relation(fields: [currency_id], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  payer_invoice   Invoice?  @relation("BillingPayerInvoice", fields: [payer_invoice_id], references: [id], onDelete: SetNull)
  receiver_invoice Invoice? @relation("BillingReceiverInvoice", fields: [receiver_invoice_id], references: [id], onDelete: SetNull)
  invoice_a       Invoice?  @relation("BillingInvoiceA", fields: [invoice_a_id], references: [id], onDelete: SetNull)
  withdrawal_request WithdrawalRequest?
  booking            Booking?  @relation("BookingBillingTransaction")

  @@index([actor_type, actor_id])
  @@index([from_type, from_id])
  @@index([to_type, to_id])
  @@index([subject_type, subject_id])
  @@index([milestone_id])
  @@index([status])
  @@index([created_at])
  @@index([unique_id])
  @@map("scd_billing_transactions")
}

model Invoice {
  id                    Int      @id @default(autoincrement())
  billing_transaction_id Int
  /** payer | receiver (legacy) — new invoices use invoice_type */
  party                 String   @db.VarChar(20)
  /** C = ScaleDux→Client, A = Freelancer→Client, B = ScaleDux→Freelancer */
  invoice_type          String?  @db.VarChar(5)

  sender_name           String   @db.VarChar(255)
  receiver_name         String   @db.VarChar(255)
  amount                Decimal  @db.Decimal(10, 2)
  currency_code         String   @db.VarChar(10)
  description           String   @db.Text
  invoice_number        String   @unique @db.VarChar(50)
  /** Platform GSTIN (issuer) */
  gst_number            String?  @db.VarChar(50)
  /** Platform GST number (same as gst_number; explicit column for clarity) */
  platform_gst          String?  @db.VarChar(50)
  /** Sender (from_id) GST if they have one */
  sender_gst            String?  @db.VarChar(50)
  /** Receiver (to_id) GST if they have one */
  receiver_gst          String?  @db.VarChar(50)
  /** Platform/service fee amount (legacy) */
  fee                    Decimal? @db.Decimal(10, 2)
  /** GST/tax amount if applicable */
  gst_amount            Decimal? @db.Decimal(10, 2)
  // New fee breakdown fields
  platform_fee_amount   Decimal? @db.Decimal(10, 2)
  commission_amount     Decimal? @db.Decimal(10, 2)
  processing_fee_amount Decimal? @db.Decimal(10, 2)
  tcs_amount            Decimal? @db.Decimal(10, 2)
  /** True if freelancer is not GST registered (Invoice A becomes Bill of Supply) */
  is_bill_of_supply     Boolean  @default(false)
  /** Financial year e.g. "2025-2026" */
  financial_year        String?  @db.VarChar(9)
  /** Sequential number within invoice_type + financial_year */
  sequence_number       Int?

  file_url              String?  @db.VarChar(500)
  /** Razorpay payment/payout details; full metadata lives here */
  meta                  Json?
  issued_at             DateTime @default(now())

  created_at            DateTime @default(now())

  payer_billing_transaction   BillingTransaction? @relation("BillingPayerInvoice")
  receiver_billing_transaction BillingTransaction? @relation("BillingReceiverInvoice")
  invoice_a_billing_transaction BillingTransaction? @relation("BillingInvoiceA")

  @@index([billing_transaction_id])
  @@index([invoice_number])
  @@index([invoice_type, financial_year])
  @@map("scd_invoices")
}

model InvoiceSequence {
  id             Int    @id @default(autoincrement())
  invoice_type   String @db.VarChar(5)
  financial_year String @db.VarChar(9)
  last_number    Int    @default(0)

  @@unique([invoice_type, financial_year])
  @@map("scd_invoice_sequences")
}

model LoginDevice {
  id            Int       @id @default(autoincrement())
  user_id       Int
  refresh_token String    @unique @db.VarChar(512)
  device_name   String?   @db.VarChar(255)
  device_type   String?   @db.VarChar(50)   // web, mobile, desktop
  browser       String?   @db.VarChar(100)
  os            String?   @db.VarChar(100)
  ip_address    String?   @db.VarChar(45)
  is_current    Boolean   @default(false)
  is_trusted    Boolean   @default(false)
  last_used_at  DateTime  @default(now())
  expires_at    DateTime
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime? // soft delete; when set, session is revoked (kept for admin)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([refresh_token])
  @@index([deleted_at])
  @@map("scd_login_devices")
}

// In-app notifications (and email sent via queue after preference check)
model Notification {
  id           Int       @id @default(autoincrement())
  user_id      Int
  type         String    @db.VarChar(80)   // NotificationEmailType
  title        String    @db.VarChar(500)
  body         String?   @db.Text
  link         String?   @db.VarChar(1024)
  read_at      DateTime?
  actor_id     Int?      // User who triggered (e.g. inviter, proposer)
  subject_type String?   @db.VarChar(80)   // FounderProject, Proposal, etc.
  subject_id   Int?
  created_at   DateTime  @default(now())
  user         User      @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)
  actor        User?     @relation("NotificationActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([user_id, read_at])
  @@index([created_at])
  @@map("scd_notifications")
}

// Generic activity log (proposal, project, etc.) – replaces MongoDB activities
model Activity {
  id                Int      @id @default(autoincrement())
  subject_type      String   @db.VarChar(80)   // Proposal, FounderProject, etc.
  subject_unique_id String   @map("subject_unique_id") @db.VarChar(64)
  type              String   @db.VarChar(80)   // STATUS_CHANGE, REQUEST_MODIFY, etc.
  payload           Json     // message, oldStatus, newStatus, etc.
  created_by_user_id Int     @map("created_by_user_id")
  created_at        DateTime @default(now())

  @@index([subject_type, subject_unique_id, created_at(sort: Desc)])
  @@map("scd_activities")
}

// Central file registry: storage path + ownership + access. Business tables store attachment.unique_id (cuid).
model Attachment {
  id                  Int       @id @default(autoincrement())
  unique_id           String    @unique @db.VarChar(36)
  owner_user_id       Int
  uploaded_by_user_id Int
  disk                String    @db.VarChar(20)   // local, bunny
  path                String    @db.VarChar(512)  // opaque storage path
  visibility          String    @db.VarChar(20)   // public, private
  mime_type           String?   @db.VarChar(128)
  size_bytes          Int?
  original_name       String?   @db.VarChar(255)
  status              String    @db.VarChar(20)  @default("attached") // temporary, attached, deleted
  accessible_user_ids  Json?     // user ids who can access (e.g. NDA signer, chat participant)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  owner               User      @relation("AttachmentOwner", fields: [owner_user_id], references: [id], onDelete: Cascade)
  uploaded_by         User      @relation("AttachmentUploadedBy", fields: [uploaded_by_user_id], references: [id], onDelete: Cascade)

  @@index([owner_user_id])
  @@index([unique_id])
  @@index([status])
  @@map("scd_attachments")
}

model RedirectLink {
  id          Int      @id @default(autoincrement())
  code        String   @unique @default(cuid())
  target_url  String
  entity_type String?  // portfolio, founder_project, investor_portfolio
  entity_id   Int?
  created_by  Int?
  click_count Int      @default(0)
  created_at  DateTime @default(now())

  @@index([code])
  @@index([entity_type, entity_id])
  @@map("scd_redirect_links")
}

/// Master data: startup phases (Phase 0 to Phase 7) with their activities and deliverables.
model StartupPhase {
  id            Int      @id @default(autoincrement())
  index         Int                                 // sort order
  display_index String   @unique @db.VarChar(10)    // "0", "1", "3.5", "7" — unique for upsert
  industry_id   Int?                                // null = generic, otherwise industry-specific override
  name          String   @db.VarChar(255)
  short_name    String   @db.VarChar(100)
  objective     String   @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  activities    StartupPhaseActivity[]
  deliverables  StartupPhaseDeliverable[]

  @@index([industry_id])
  @@map("scd_startup_phases")
}

/// Activities within a phase. type = 'must_have' or 'good_to_have'.
model StartupPhaseActivity {
  id        Int      @id @default(autoincrement())
  phase_id  Int
  type      String   @db.VarChar(20)                 // must_have | good_to_have
  order     Int      @default(0)
  title     String   @db.Text
  details   String   @db.Text
  created_at DateTime @default(now())

  phase StartupPhase @relation(fields: [phase_id], references: [id], onDelete: Cascade)

  @@unique([phase_id, type, order])
  @@index([phase_id, type])
  @@map("scd_startup_phase_activities")
}

/// Deliverables within a phase (output documents/files the founder produces).
model StartupPhaseDeliverable {
  id         Int      @id @default(autoincrement())
  phase_id   Int
  order      Int      @default(0)
  title      String   @db.Text
  details    String   @db.Text
  created_at DateTime @default(now())

  phase StartupPhase @relation(fields: [phase_id], references: [id], onDelete: Cascade)

  @@unique([phase_id, order])
  @@index([phase_id])
  @@map("scd_startup_phase_deliverables")
}

/// Per-founder progress: which phase they are on, completed activities, uploaded deliverable files.
model UserStartupProgress {
  id                  Int      @id @default(autoincrement())
  user_id             Int      @unique
  current_phase_id    Int?
  /// Array of completed activity ids: ["1", "2", "5", ...]
  completed_activities Json    @default("[]")
  /// Map of deliverable_id -> { url, name, size, uploaded_at }
  deliverables        Json     @default("{}")
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_user_startup_progress")
}

model Booking {
  id                     Int       @id @default(autoincrement())
  unique_id              String    @unique @default(cuid())
  mentor_id              Int
  user_id                Int       // the person booking (mentee/client)
  title                  String    @db.VarChar(255)
  description            String?   @db.Text
  duration               Int       // minutes
  scheduled_at           DateTime
  scheduled_end          DateTime
  message                String?   @db.Text  // discussion points from booker
  status                 String    @default("PENDING") @db.VarChar(20)
  // PENDING → CONFIRMED (after payment) → COMPLETED | CANCELLED | REJECTED | RESCHEDULED
  payment_status         String    @default("UNPAID") @db.VarChar(20)
  // UNPAID → PAID → RELEASED | REFUNDED
  amount                 Decimal   @db.Decimal(12, 2)
  currency_id            Int       @default(1)
  platform_fee           Decimal?  @db.Decimal(12, 2)
  razorpay_order_id      String?   @db.VarChar(64)
  meta                   Json?
  // Video conferencing
  meeting_link           String?   @db.VarChar(500)
  meeting_provider       String?   @db.VarChar(20) // "zoom" | "google_meet" | "ms_teams" | "manual"
  // Reschedule chain
  parent_id              Int?      // original booking this was rescheduled from
  is_reschedule          Boolean   @default(false)
  rescheduled_by         Int?      // user who initiated the reschedule
  reschedule_count       Int       @default(0) // how many times this booking chain has been rescheduled
  reschedule_requested_at DateTime? // set when the mentor requests a reschedule (pending the founder's response)
  reschedule_response_deadline DateTime? // 48hr deadline for founder to respond to reschedule request
  // Cancellation
  cancelled_by           Int?
  cancelled_at           DateTime?
  // Completion / Rejection
  completed_at           DateTime?  // mentor confirmed
  user_approved_at       DateTime?  // user accepted the confirmation
  rejected_at            DateTime?
  completion_reminder_sent_at DateTime?
  // Recording
  wants_recording        Boolean   @default(false)
  recording_amount       Decimal?  @db.Decimal(12, 2)
  // Billing
  billing_transaction_id Int?      @unique
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  mentor                 User      @relation("BookingMentor", fields: [mentor_id], references: [id])
  user                   User      @relation("BookingUser", fields: [user_id], references: [id])
  currency               Currency  @relation(fields: [currency_id], references: [id])
  parent                 Booking?          @relation("BookingReschedule", fields: [parent_id], references: [id])
  rescheduled            Booking[]         @relation("BookingReschedule")
  activities             BookingActivity[] @relation("BookingActivities")
  billing_transaction    BillingTransaction? @relation("BookingBillingTransaction", fields: [billing_transaction_id], references: [id])

  @@index([mentor_id, scheduled_at])
  @@index([user_id, status])
  @@index([status])
  @@index([parent_id])
  @@map("scd_bookings")
}

model BookingActivity {
  id          Int      @id @default(autoincrement())
  booking_id  Int
  action      String   @db.VarChar(50) // CANCELLED | RESCHEDULED | REJECTED | COMPLETED | MEETING_LINK_REQUESTED | LINK_REMINDER_*
  reason      String?  @db.VarChar(120)
  remark      String?  @db.Text
  acted_by    Int
  created_at  DateTime @default(now())

  booking     Booking  @relation("BookingActivities", fields: [booking_id], references: [id])
  actor       User     @relation("BookingActivityActor", fields: [acted_by], references: [id])

  @@index([booking_id])
  @@index([acted_by])
  @@map("scd_booking_activities")
}

model SuccessStory {
  id                Int       @id @default(autoincrement())
  user_id           Int
  title             String    @db.VarChar(255)
  description       String?   @db.VarChar(900)
  date              DateTime? @db.Date
  organisation_name String    @db.VarChar(255)
  client_name       String?   @db.VarChar(255)
  linkedin_link     String?   @db.VarChar(500)
  media_files       Json?     // Array of attachment unique_ids (max 5, PNG/JPG/PDF, 5MB, 600x400px)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("scd_success_stories")
}

model Connection {
  id            Int       @id @default(autoincrement())
  sender_id     Int
  receiver_id   Int
  status        String    @default("REQUESTED") @db.VarChar(20) // REQUESTED, CONNECTED, REJECTED, WITHDRAWN, DISCONNECTED
  note          String?   @db.Text
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  sender   User @relation("ConnectionSender", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver User @relation("ConnectionReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@unique([sender_id, receiver_id])
  @@index([receiver_id, status])
  @@index([sender_id, status])
  @@map("scd_connections")
}

// ──────────────────────────────────────────────────────────────
// Admin panel — dedicated admin accounts, sessions & audit trail.
// Managed by the standalone scaledux-admin-api (shares this DB).
// ──────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN // full access incl. managing other admins
  ADMIN       // broad access, cannot manage admins
  MODERATOR   // content / projects / proposals / reviews / reports
  FINANCE     // billing, payments, payouts, invoices
  SUPPORT     // read-mostly + user assistance
}

model Admin {
  id             Int       @id @default(autoincrement())
  unique_id      String    @unique @default(cuid())
  name           String
  email          String    @unique
  password       String
  role           AdminRole @default(ADMIN)
  /** Optional fine-grained permission keys, e.g. ["users.suspend","billing.refund"]. Null = role defaults. */
  permissions    Json?
  avatar_url     String?
  phone          String?
  /** 1 = active, 0 = suspended */
  status         Int       @default(1)
  two_fa_enabled Boolean   @default(false)
  last_login_at  DateTime?
  created_by     Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  sessions   AdminSession[]
  audit_logs AdminAuditLog[]

  @@index([role])
  @@index([status])
  @@map("scd_admins")
}

model AdminSession {
  id         Int       @id @default(autoincrement())
  admin_id   Int
  /** sha256 hash of the issued refresh token */
  token_hash String    @unique
  ip_address String?
  user_agent String?
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@map("scd_admin_sessions")
}

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  admin_id    Int?
  /** dotted action key, e.g. "user.suspend", "billing.refund" */
  action      String
  /** entity affected, e.g. "User", "Proposal", "BillingTransaction" */
  entity_type String?
  entity_id   String?
  description String?  @db.Text
  metadata    Json?
  ip_address  String?
  created_at  DateTime @default(now())

  admin Admin? @relation(fields: [admin_id], references: [id], onDelete: SetNull)

  @@index([admin_id])
  @@index([entity_type, entity_id])
  @@index([action])
  @@map("scd_admin_audit_logs")
}
