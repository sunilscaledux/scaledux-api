generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  FirstName         String
  LastName          String?
  email             String?   @unique
  phone             String?   @unique
  email_verified_at DateTime?
  phone_verified_at DateTime?
  password          String?
  status            Int       @default(1)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  notification      Boolean   @default(false)
  terms             Boolean   @default(true)
  googleId          String?   @unique
  linkedinId        String?   @unique
  profileImage      String?
  provider          String?
  coverImage        String?
  hideEmail         Boolean   @default(false)
  hidePhone         Boolean   @default(false)
  uniqueId          String    @unique
  otps              Otp[]
  personalInfo      PersonalInfo?
  education         Education[]
  licenses          License[]
  workExperiences   WorkExperience[]
  achievements      Achievement[]
  expertises        UserExpertise[]

  @@index([email, phone])
  @@index([LastName, FirstName, email])
  @@index([googleId])
  @@index([linkedinId])
  @@map("users")
}

model PersonalInfo {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  title          String?
  about          String?
  address        String?
  address_line_2 String?
  city           String?
  website        String?
  zipCode        String?
  hourly_rate    Float?
  links          Json?
  currency_id    Int?
  country_id     Int?
  state_id       Int?
  languages          Json?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  currency       Currency? @relation(fields: [currency_id], references: [id])
  country        Country?  @relation(fields: [country_id], references: [id])
  state          State?    @relation(fields: [state_id], references: [id])

  @@map("personal_info")
}

model Education {
  id            Int      @id @default(autoincrement())
  user_id       Int
  school        String
  degree        String
  area_of_study String
  start_month   String
  start_year    String
  end_month     String?
  end_year      String?
  is_ongoing    Boolean  @default(false)
  description   String?
  skills        Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("education")
}

model License {
  id               Int      @id @default(autoincrement())
  user_id          Int
  institute        String
  license_name     String
  completed_month  String
  completed_year   String
  description      String?
  skills           Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("licenses")
}

model ExpertiseCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  is_active   Boolean         @default(true)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  expertises  UserExpertise[]
  specialties Specialty[]

  @@map("expertise_categories")
}

model Specialty {
  id                    Int               @id @default(autoincrement())
  name                  String
  description           String?
  expertise_category_id Int
  is_active             Boolean           @default(true)
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  expertiseCategory     ExpertiseCategory @relation(fields: [expertise_category_id], references: [id])
  expertises            UserExpertise[]
  skills                Skill[]

  @@unique([name, expertise_category_id])
  @@map("specialties")
}

model Skill {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  specialty_id Int
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  specialty    Specialty @relation(fields: [specialty_id], references: [id])

  @@unique([name, specialty_id])
  @@map("skills")
}

model UserExpertise {
  id                    Int               @id @default(autoincrement())
  user_id               Int
  expertise_category_id Int
  specialty_id          Int
  description           String?
  skills                Json? // Array of skill names
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  user                  User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expertiseCategory     ExpertiseCategory @relation(fields: [expertise_category_id], references: [id])
  specialty             Specialty         @relation(fields: [specialty_id], references: [id])

  @@map("user_expertises")
}

model Otp {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  email      String?
  phone      String?
  otp_code   String
  otp_type   OtpType
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email, otp_type, verified])
  @@index([phone, otp_type, verified])
  @@index([expires_at])
  @@map("otps")
}

model Country {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  code         String         @unique
  phone_code   String?        // Phone country code like +91, +1, +44
  flag         String?
  currency_id  Int?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  currency     Currency?      @relation(fields: [currency_id], references: [id])
  states       State[]
  personalInfo PersonalInfo[]

  @@map("countries")
}

model State {
  id           Int            @id @default(autoincrement())
  name         String
  code         String?
  country_id   Int
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  country      Country        @relation(fields: [country_id], references: [id], onDelete: Cascade)
  personalInfo PersonalInfo[]

  @@unique([name, country_id])
  @@map("states")
}

model Currency {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  code         String         @unique
  symbol       String
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  countries    Country[]
  personalInfo PersonalInfo[]

  @@map("currencies")
}

model Language {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  native_name  String?
  code         String   @unique
  country_code String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("languages")
}

model WorkExperience {
  id                Int      @id @default(autoincrement())
  user_id           Int
  role              String
  company           String
  company_website   String?
  description       String?
  start_month       String
  start_year        String
  end_month         String?
  end_year          String?
  is_current        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model Achievement {
  id                Int      @id @default(autoincrement())
  user_id           Int
  title             String
  description       String?
  company           String
  completed_month   String
  completed_year    String
  achievement_link  String?
  media_files       Json?    // Array of media file objects with type, url, name
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("achievements")
}

enum OtpType {
  REGISTRATION_VERIFICATION
  LOGIN_VERIFICATION
  FORGOT_PASSWORD_VERIFICATION
  PHONE_VERIFICATION
}

