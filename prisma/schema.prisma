generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  unique_id         String?   @unique
  first_name        String
  middle_name       String?
  last_name         String?
  email             String?   @unique
  phone             String?   @unique
  email_verified_at DateTime?
  phone_verified_at DateTime?
  password          String?
  status            Int       @default(1)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  notification      Boolean   @default(false)
  terms             Boolean   @default(true)
  googleId          String?   @unique
  linkedinId        String?   @unique
  provider          String?
  role              String?   
  identity_verified_at         DateTime?
  identity_verification_status String?   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  agency_verified_at           DateTime?
  otps                         Otp[]
  personalInfo                 PersonalInfo?
  companyProfile               CompanyProfile?
  education                    Education[]
  licenses                     License[]
  workExperiences              WorkExperience[]
  achievements                 Achievement[]
  expertises                   UserExpertise[]
  identityVerifications        IdentityVerification[]
  agencyVerifications          AgencyVerification[]
  founderProjects              FounderProject[]
  agency_verification_status   String?   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  show_as_agency               Boolean   @default(false)
  portfolios                   Portfolio[]
  investmentPortfolios         InvestorPortfolio[]
  investmentProfile            InvestmentProfile?
  servicePackages              ServicePackage[]
  paymentMethods               PaymentMethod[]
  withdrawalMethods            WithdrawalMethod[]
  withdrawal_requests          WithdrawalRequest[]
  taxInformation               TaxInformation?
  currency_id                  Int?
  currency                     Currency? @relation(fields: [currency_id], references: [id])
  profile_completion_percentage Int?    // 0-100, cached from preference.profile_sections + role weights
  preference                    UserPreference?
  wallet                        UserWallet?
  projectInvites               ProjectInvite[] @relation("ProjectInvites")
  savedProjects                SavedProject[] @relation("SavedProjects")
  proposals                    Proposal[] @relation("UserProposals")
  reviewsGiven                 Review[]   @relation("ReviewsGiven")
  reviewsReceived              Review[]   @relation("ReviewsReceived")
  conversationsAsUser1        Conversation[] @relation("ConversationUser1")
  conversationsAsUser2         Conversation[] @relation("ConversationUser2")
  sentMessages                 Message[]
  loginDevices                 LoginDevice[]
  notifications                Notification[]
  is_deactivated               Boolean   @default(false)
  scheduleTermination          ScheduleTermination?
  /** Razorpay X contact id (cont_xxx); reused when user updates bank so we don't create duplicate contacts. */
  razorpay_contact_id          String?   @db.VarChar(64)
  /** Razorpay X fund account id (fa_xxx) for freelancer payouts (set after bank verification). */
  razorpay_account_id          String?   @db.VarChar(64)
  attachmentsOwned              Attachment[] @relation("AttachmentOwner")
  attachmentsUploaded          Attachment[] @relation("AttachmentUploadedBy")
  @@index([email, phone])
  @@index([last_name, first_name, email])
  @@index([googleId])
  @@index([linkedinId])
  @@map("scd_users")
}

/** Section completion + email notification preferences (moved off User). */
model UserPreference {
  id                            Int      @id @default(autoincrement())
  user_id                       Int      @unique
  /** Role-based profile section completion: { [sectionKey]: boolean }. */
  profile_sections               Json?
  /** Per-type email preference: { [NotificationEmailType]: boolean }. false = do not send. */
  email_notification_preferences Json?
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt

  user                          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@map("scd_user_preferences")
}

/** Wallet and billing totals (moved off User). One row per user. */
model UserWallet {
  id                Int      @id @default(autoincrement())
  user_id           Int      @unique
  wallet_amount     Decimal  @db.Decimal(15, 2) @default(0)  // current balance
  total_earning     Decimal  @db.Decimal(15, 2) @default(0)  // sum of completed credits received
  total_withdrawal  Decimal  @db.Decimal(15, 2) @default(0)  // sum of completed withdrawals
  pending_amount    Decimal  @db.Decimal(15, 2) @default(0)  // sum of pending credits to be received
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@map("scd_user_wallets")
}

// Personal Info - Common for all user types
model PersonalInfo {
  id                    Int       @id @default(autoincrement())
  user_id               Int       @unique
  // Profile fields
  profileImage          String?
  coverImage            String?
  hideEmail             Boolean   @default(false)
  hidePhone             Boolean   @default(false)
  title                 String?
  about                 String?
  address               String?
  address_line_2        String?
  city                  String?
  website               String?
  zipCode               String?
  hourly_rate           Float?
  available_hours_per_week Int?
  links                 Json?     // Social media links
  languages             Json?
  show_as_agency        Boolean   @default(false)
  keycode               String?   @unique // Unique keycode for identity verification
  // Relations
  country_id            Int?
  state_id              Int?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  country               Country?  @relation(fields: [country_id], references: [id])
  state                 State?    @relation(fields: [state_id], references: [id])

  @@index([user_id])
  @@map("scd_personal_info")
}

// Company/Founder Profile
model CompanyProfile {
  id                    Int       @id @default(autoincrement())
  user_id               Int       @unique
  unique_id             String    @unique
  
  // Profile fields
  profileImage          String?
  coverImage            String?
  
  // Company information
  company_name          String?
  company_description   String?
  company_website       String?
  cin                   String?
  company_size          String?
  founded_year          Int?
  company_stage         String?
  team_size             Int?
  
  // Business model
  revenue_model_ids     Int[]     @default([])
  revenue_description   String?   @db.Text
  target_market         String?
  problem_statement     String?
  solution_statement    String?
  
  // Traction
  traction_title        String?
  traction_document     String?
  
  // Funding
  funding_status        String?
  total_funding         Decimal?  @db.Decimal(15, 2)
  
  // Location
  address               String?
  address_line_2        String?
  city                  String?
  zipCode               String?
  
  // Social links
  links                 Json?
  
  // Relations
  country_id            Int?
  state_id              Int?
  industry_id           Int?
  sub_industry_id       Int?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  country               Country?  @relation(fields: [country_id], references: [id])
  state                 State?    @relation(fields: [state_id], references: [id])
  industry              Industry? @relation(fields: [industry_id], references: [id])
  subIndustry           SubIndustry? @relation(fields: [sub_industry_id], references: [id])
  teamMembers           TeamMember[]
  fundingRounds         FundingRound[]
  raisingFund           RaisingFund?

  @@index([unique_id])
  @@index([user_id])
  @@map("scd_company_profiles")
}

model FundingRound {
  id                    Int       @id @default(autoincrement())
  company_profile_id    Int
  investor_name         String
  funding_stage         String
  funding_amount        Decimal   @db.Decimal(15, 2)
  funding_date          DateTime
  funding_valuation     Decimal?  @db.Decimal(15, 2)
  deleted_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  companyProfile        CompanyProfile @relation(fields: [company_profile_id], references: [id], onDelete: Cascade)

  @@index([company_profile_id])
  @@map("scd_funding_rounds")
}

model RaisingFund {
  id                    Int       @id @default(autoincrement())
  company_profile_id    Int       @unique
  is_raising            Boolean   @default(false)
  round_type            String?
  target_amount         Decimal?  @db.Decimal(15, 2)
  uses_of_fund          Json?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  companyProfile        CompanyProfile @relation(fields: [company_profile_id], references: [id], onDelete: Cascade)

  @@map("scd_raising_funds")
}

model Education {
  id            Int      @id @default(autoincrement())
  user_id       Int
  school        String
  degree        String
  area_of_study String
  start_month   String
  start_year    String
  end_month     String?
  end_year      String?
  is_ongoing    Boolean  @default(false)
  description   String?
  skills        Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_education")
}

model License {
  id               Int      @id @default(autoincrement())
  user_id          Int
  institute        String
  license_name     String
  completed_month  String
  completed_year   String
  description      String?
  skills           Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_licenses")
}

model Category {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  description     String?
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  expertises      UserExpertise[]
  subcategories   Subcategory[]
  skills          Skill[]
  founderProjects FounderProject[]
  servicePackages ServicePackage[]

  @@map("scd_expertise_categories")
}

model Subcategory {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  categoryId    Int       @map("expertise_category_id")
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  category      Category  @relation(fields: [categoryId], references: [id])
  founderProjects FounderProject[]
  servicePackages ServicePackage[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("scd_specialties")
}

model Skill {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  categoryId  Int      @map("expertise_category_id")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("scd_skills")
}

model Industry {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  portfolios      Portfolio[]
  investorPortfolios InvestorPortfolio[]
  subIndustries   SubIndustry[]
  companyProfiles CompanyProfile[]
  investmentProfilePreferredIndustries InvestmentProfilePreferredIndustry[]

  @@map("scd_industries")
}

model SubIndustry {
  id              Int              @id @default(autoincrement())
  industry_id     Int
  name            String
  description     String?
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  industry        Industry         @relation(fields: [industry_id], references: [id], onDelete: Cascade)
  companyProfiles CompanyProfile[]
  investorPortfolios InvestorPortfolio[]
  investmentProfilePreferredIndustries InvestmentProfilePreferredIndustry[]

  @@unique([industry_id, name])
  @@index([industry_id])
  @@map("scd_sub_industries")
}

model BusinessModel {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("scd_business_models")
}

model RevenueModel {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("scd_revenue_models")
}

model TeamRole {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  code        String       @unique
  description String?
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  teamMembers TeamMember[]

  @@map("scd_team_roles")
}

model TeamMember {
  id                Int       @id @default(autoincrement())
  unique_id         String    @unique @default(cuid())
  company_profile_id Int
  name              String
  email             String?
  role_id           Int
  bio               String?
  profile_image     String?
  linkedin_url      String?
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  companyProfile    CompanyProfile @relation(fields: [company_profile_id], references: [id], onDelete: Cascade)
  role              TeamRole  @relation(fields: [role_id], references: [id])

  @@index([company_profile_id])
  @@index([unique_id])
  @@map("scd_team_members")
}

model UserExpertise {
  id            Int         @id @default(autoincrement())
  user_id       Int
  categoryId    Int         @map("expertise_category_id")
  specialty_ids Json?
  description   String?
  skills        Json?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  user          User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id])

  @@map("scd_user_expertises")
}

model Otp {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  email      String?
  phone      String?
  otp_code   String
  otp_type   OtpType
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email, otp_type, verified])
  @@index([phone, otp_type, verified])
  @@index([expires_at])
  @@map("scd_otps")
}

model Country {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  code               String              @unique
  phone_code         String?             // Phone country code like +91, +1, +44
  flag               String?
  currency_id        Int?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  currency           Currency?           @relation(fields: [currency_id], references: [id])
  states             State[]
  personalInfos      PersonalInfo[]
  companyProfiles    CompanyProfile[]
  investmentProfileGeoPreferences InvestmentProfileGeoPreference[]

  @@map("scd_countries")
}

model State {
  id                 Int                 @id @default(autoincrement())
  name               String
  code               String?
  country_id         Int
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  country            Country             @relation(fields: [country_id], references: [id], onDelete: Cascade)
  personalInfos      PersonalInfo[]
  companyProfiles    CompanyProfile[]
  investmentProfileGeoPreferences InvestmentProfileGeoPreference[]

  @@unique([name, country_id])
  @@map("scd_states")
}

model Currency {
  id                  Int                   @id @default(autoincrement())
  name                String                @unique
  code                String                @unique
  symbol              String
  exchange_rate       Decimal               @default(1.0) @db.Decimal(10, 6) // Exchange rate to USD (1 USD = X currency)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  countries           Country[]
  users               User[]
  billingTransactions BillingTransaction[]

  @@map("scd_currencies")
}

model Language {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  native_name  String?
  code         String   @unique
  country_code String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("scd_languages")
}

model WorkExperience {
  id                Int      @id @default(autoincrement())
  user_id           Int
  role              String
  company           String
  company_website   String?
  description       String?
  start_month       String
  start_year        String
  end_month         String?
  end_year          String?
  is_current        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_work_experiences")
}

model Achievement {
  id                Int      @id @default(autoincrement())
  user_id           Int
  title             String
  description       String?
  company           String
  completed_month   String
  completed_year    String
  achievement_link  String?
  media_files       Json?    // Array of media file objects with type, url, name
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_achievements")
}

model IdentityVerification {
  id                        Int       @id @default(autoincrement())
  user_id                   Int
  first_name                String
  middle_name               String?
  last_name                 String
  date_of_birth             DateTime
  nationality               String?
  id_type                   String    // passport, driver_license, national_id, etc.
  id_number                 String
  id_expiry_date            DateTime?
  issuing_country           String
  id_document_urls          Json      // Array of document image URLs
  keycode                   String?   // Keycode used for this verification
  selfie_urls               Json      // Array of selfie image URLs
  address_line_1            String
  address_line_2            String?
  city                      String
  state                     String?
  postal_code               String?
  address_country           String
  proof_of_address_consent  String?
  address_proof_urls        Json?     // Array of address proof document URLs
  document_type             String?   // bank-statement, utility-bill
  institution_name          String?   // Bank or utility company name
  document_date_issued      DateTime? // Date when document was issued
  status                    String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  submitted_at              DateTime?
  verified_at               DateTime?
  verified_by               Int?
  rejection_reason          String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  user                      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([status])
  @@map("scd_identity_verifications")
}

model AgencyVerification {
  id                Int       @id @default(autoincrement())
  user_id           Int
  agency_name       String
  cin               String    // Corporate Identification Number
  document_urls     Json?     // Array of document URLs
  status            String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  submitted_at      DateTime?
  verified_at       DateTime?
  verified_by       Int?
  rejection_reason  String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([status])
  @@map("scd_agency_verifications")
}

model Portfolio {
  id                 Int       @id @default(autoincrement())
  unique_id          String    @unique @default(cuid())
  user_id            Int
  title              String?
  description        String?   @db.Text
  company_name       String?
  hide_company_name  Boolean   @default(false)
  industry_id        Int?
  role               String?
  project_skills     Json?     // Array of skill names
  thumbnail_url      String?   // Single thumbnail image URL
  media_urls         Json?     // Array of media file URLs
  project_link       String?
  completion_month   String?
  completion_year    String?
  references         Json?     // Array of reference URLs
  status             String    @default("DRAFT") // DRAFT, PUBLISHED
  deleted_at         DateTime? // Soft delete timestamp
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  industry           Industry? @relation(fields: [industry_id], references: [id])

  @@index([user_id, status])
  @@index([status])
  @@index([industry_id])
  @@index([deleted_at])
  @@map("scd_portfolios")
}

// Investor's investment portfolio - companies they've invested in
model InvestorPortfolio {
  id                    Int       @id @default(autoincrement())
  unique_id             String    @unique @default(cuid())
  user_id               Int
  
  // Company overview
  company_name          String
  company_logo          String?
  description           String?   @db.Text
  company_website       String?
  industry_id           Int?
  sub_industry_id       Int?
  
  // Investment details
  investment_size           Decimal?  @db.Decimal(15, 2)
  investment_size_currency  String?   // USD, INR
  investment_date           DateTime?
  round_participated_in     String?   // Pre Seed, Angel, Seed, Pre Series A+
  current_status        String?   @default("Active") // Active, Exited, Acquired
  
  // Strategic role
  board_advisory_role   String?
  impact_in_company_growth String? @db.Text
  exit_information      String?   @db.Text
  
  // Status and timestamps
  status                String    @default("DRAFT") // DRAFT, PUBLISHED
  deleted_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  industry              Industry? @relation(fields: [industry_id], references: [id])
  subIndustry           SubIndustry? @relation(fields: [sub_industry_id], references: [id])

  @@index([user_id, status])
  @@index([status])
  @@index([industry_id])
  @@index([deleted_at])
  @@map("scd_investor_portfolios")
}

// Investment profile - one per user (investor); single-value details and links to detail tables
model InvestmentProfile {
  id                      Int       @id @default(autoincrement())
  unique_id               String    @unique @default(cuid())
  user_id                 Int       @unique

  // Single-value fields (investor type, thesis, diligence, ticket size, equity range)
  investor_types          Json?     // ["Angel investor", "Micro VCs"] - selected values from constants
  thesis_summary          String?   @db.Text
  diligence_process       String?   @db.Text
  diligence_document      String?   // file path
  investment_size_min     Decimal?  @db.Decimal(15, 2)
  investment_size_max     Decimal?  @db.Decimal(15, 2)
  investment_size_currency String?  // USD, INR
  equity_range_min       Int?      // percentage 0-100
  equity_range_max       Int?      // percentage 0-100

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  user                    User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  preferredIndustries      InvestmentProfilePreferredIndustry[]
  committeeMembers        InvestmentProfileCommitteeMember[]
  geoPreferences          InvestmentProfileGeoPreference[]

  @@index([user_id])
  @@map("scd_investment_profiles")
}

// Preferred investment industry - many per profile (industry + optional specialisation, stage, criteria)
model InvestmentProfilePreferredIndustry {
  id                    Int       @id @default(autoincrement())
  investment_profile_id Int
  industry_id           Int
  sub_industry_id       Int?
  specialisation        String?   @db.VarChar(500)
  investment_stage     String?   @db.VarChar(255)
  investment_criteria   String?   @db.Text
  order_index          Int       @default(0)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  investmentProfile     InvestmentProfile @relation(fields: [investment_profile_id], references: [id], onDelete: Cascade)
  industry              Industry         @relation(fields: [industry_id], references: [id], onDelete: Cascade)
  subIndustry           SubIndustry?      @relation(fields: [sub_industry_id], references: [id], onDelete: SetNull)

  @@index([investment_profile_id])
  @@index([industry_id])
  @@map("scd_investment_profile_preferred_industries")
}

// Investment committee structure - many members per profile
model InvestmentProfileCommitteeMember {
  id                    Int       @id @default(autoincrement())
  unique_id             String    @unique @default(cuid())
  investment_profile_id Int
  name                  String    @db.VarChar(255)
  role                  String?   @db.VarChar(255)   // e.g. Founder & CEO, CEO, CTO
  role_description      String?   @db.Text
  photo                 String?   // file path
  email                 String?   @db.VarChar(255)
  hide_email            Boolean   @default(false)
  order_index           Int       @default(0)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  investmentProfile     InvestmentProfile @relation(fields: [investment_profile_id], references: [id], onDelete: Cascade)

  @@index([investment_profile_id])
  @@map("scd_investment_profile_committee_members")
}

// Geographic preference - many country/state entries per profile
model InvestmentProfileGeoPreference {
  id                    Int       @id @default(autoincrement())
  investment_profile_id Int
  country_id            Int
  state_id              Int?
  order_index           Int       @default(0)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  investmentProfile     InvestmentProfile @relation(fields: [investment_profile_id], references: [id], onDelete: Cascade)
  country               Country          @relation(fields: [country_id], references: [id], onDelete: Cascade)
  state                 State?           @relation(fields: [state_id], references: [id], onDelete: SetNull)

  @@index([investment_profile_id])
  @@index([country_id])
  @@map("scd_investment_profile_geo_preferences")
}

model FounderProject {
  id                    Int       @id @default(autoincrement())
  unique_id             String    @unique @default(cuid())
  user_id               Int
  project_title         String    @db.VarChar(50)
  project_description   String    @db.Text
  expertise_category_id Int
  specialty_id          Int?
  project_files         Json      @default("[]")
  scope_of_work         String    @db.Text
  skills_required       Json
  experience_needed     String    @db.VarChar(50)
  budget_currency       String    @db.VarChar(10)
  budget_amount         String    @db.VarChar(20)
  is_nda_required       Boolean   @default(false)
  screening_questions   Json      @default("[]")
  advanced_preferences  Json
  status                String    @default("DRAFT")
  invited_count         Int       @default(0)
  proposals_count       Int       @default(0)
  hired_count           Int       @default(0)
  saved_providers       Json      @default("[]") // Array of provider user IDs saved for later
  deleted_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [expertise_category_id], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [specialty_id], references: [id], onDelete: SetNull)
  invites               ProjectInvite[]
  savedByUsers          SavedProject[]
  proposals             Proposal[]
  milestones            Milestone[]

  @@index([user_id, status])
  @@index([status])
  @@index([expertise_category_id])
  @@index([specialty_id])
  @@index([deleted_at])
  @@index([created_at])
  @@map("scd_founder_projects")
}

// Stores matched service providers for a project
model ProjectInvite {
  id                    Int       @id @default(autoincrement())
  project_id            Int
  provider_id           Int       // Freelancer user id
  message               String?   @db.Text
  status                String    @default("PENDING") @db.VarChar(20) // PENDING, ACCEPTED, REJECTED
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt
  
  project               FounderProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  provider              User @relation("ProjectInvites", fields: [provider_id], references: [id], onDelete: Cascade)

  @@unique([project_id, provider_id])
  @@index([project_id])
  @@index([provider_id])
  @@index([status])
  @@map("scd_project_invites")
}

// Service providers save projects they're interested in
model SavedProject {
  id                    Int       @id @default(autoincrement())
  project_id            Int
  user_id               Int       // Service provider user id
  created_at            DateTime  @default(now())
  
  project               FounderProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user                  User @relation("SavedProjects", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([project_id])
  @@index([user_id])
  @@map("scd_saved_projects")
}

// Proposals submitted by service providers for founder projects
model Proposal {
  id                    Int       @id @default(autoincrement())
  unique_id             String    @unique @default(cuid())
  project_id            Int
  provider_id           Int       // Service provider user id
  status                String    @default("PENDING") @db.VarChar(20) // PENDING, SHORTLISTED, OFFER_SENT, OFFER_ACCEPTED, REJECTED, WITHDRAWN, HIRED, TERMINATING, TERMINATED
  
  // Proposal content
  cover_letter          String    @db.Text
  proposed_amount       Decimal   @db.Decimal(15, 2)
  payment_schedule      String    @db.VarChar(20) // byProject, byMilestone
  /** Freelancer’s estimated hours for the whole project (not per milestone). */
  hours_required        Int?
  screening_answers     Json      @default("[]") // Answers to screening questions
  attachments           Json      @default("[]") // File URLs
  remark                String?   @db.Text       // Optional message or full display text (reason label + message)
  main_reason           String?   @db.VarChar(50) // Predefined reason key (e.g. BUDGET_MISMATCH, OTHER) from proposal reasons

  // Lock milestones after hire (no more edit/delete)
  milestones_approved   Boolean   @default(false) // true when status becomes HIRED

  // Timestamps
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt
  /** When set, contract is scheduled to terminate at this time (1 week from user action). Only terminate_by can restore. */
  terminate_at          DateTime?
  /** User id who scheduled termination; only this user can restore. */
  terminate_by          Int?

  // Relations
  project               FounderProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  provider              User @relation("UserProposals", fields: [provider_id], references: [id], onDelete: Cascade)
  milestonesRows       Milestone[]
  proposalNda           ProposalNda?   // NDA + offer: sent/signed/download timestamps and file links (1:1)

  @@unique([project_id, provider_id]) // One proposal per provider per project
  @@index([project_id])
  @@index([provider_id])
  @@index([status])
  @@map("scd_proposals")
}

// NDA and offer data per proposal (sent document, signed document, timestamps)
model ProposalNda {
  id                      Int       @id @default(autoincrement())
  proposal_id             Int       @unique
  /** When the offer expires (countdown from nda_sent_at + OFFER_EXPIRY_HOURS). */
  offer_expires_at        DateTime?
  /** True when freelancer has signed the NDA. */
  is_nda_signed           Boolean   @default(false)
  /** Attachment unique_id or path for the NDA document sent by founder. */
  nda_file_link           String?   @db.VarChar(512)
  /** When founder sent the NDA / offer. */
  nda_sent_at             DateTime?
  /** When freelancer signed the NDA. */
  nda_signed_at           DateTime?
  /** Attachment unique_id or path for the signed NDA uploaded by freelancer. */
  nda_signed_file_link    String?   @db.VarChar(512)
  /** When NDA was downloaded (founder or freelancer). */
  nda_downloaded_at      DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  proposal                Proposal  @relation(fields: [proposal_id], references: [id], onDelete: Cascade)

  @@map("scd_proposal_ndas")
}

// Polymorphic review: one row per public or private review (review_type). Used for contracts, mentor sessions, etc.
model Review {
  id              Int       @id @default(autoincrement())
  unique_id       String    @unique @default(cuid())

  review_from_id  Int       // User id of reviewer
  review_to_id    Int       // User id being reviewed
  action_type     String    @db.VarChar(50)   // e.g. PROPOSAL_CONTRACT, MENTOR_SESSION
  action_id       String    @db.VarChar(100)  // e.g. proposal unique_id

  review_type     String    @db.VarChar(20)  // PUBLIC | PRIVATE
  rating          Decimal   @db.Decimal(3, 2) // 0-10 private, 0-5 public overall
  feedback        String?   @db.Text
  end_reason      String?   @db.VarChar(255) // For PRIVATE; null for PUBLIC
  ratings_extra   Json?     // For PUBLIC category breakdown { skills, qualityOfWork, ... }; null for PRIVATE

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  review_from     User      @relation("ReviewsGiven", fields: [review_from_id], references: [id], onDelete: Cascade)
  review_to       User      @relation("ReviewsReceived", fields: [review_to_id], references: [id], onDelete: Cascade)

  @@unique([review_from_id, review_to_id, action_type, action_id, review_type])
  @@index([review_to_id, action_type])
  @@index([action_type, action_id])
  @@map("scd_reviews")
}

// Milestones linked to project and proposal (enables per-milestone docs and status)
model Milestone {
  id               Int       @id @default(autoincrement())
  unique_id        String    @unique @default(cuid())
  project_id       Int
  proposal_id      Int
  order_index      Int       @default(0)   // 0-based order within proposal
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  amount           Decimal   @db.Decimal(15, 2)
  due_date         DateTime? @db.Date
  hours_required   Int?
  status           String    @default("PENDING") @db.VarChar(20) // Milestone completion: PENDING, IN_PROGRESS, COMPLETED, PAID (exposed as milestone_status in API)
  payment_status   String    @default("PENDING") @db.VarChar(20) // PENDING, FUNDED, RELEASED
  /** Platform service fee (amount) deducted when payment was released; set on release. */
  service_fee_amount Decimal? @db.Decimal(10, 2)
  /** When true, this milestone cannot be edited/deleted (e.g. set when proposal is HIRED or milestone approved) */
  is_approved      Boolean   @default(false)
  /** Client/founder message (e.g. note when approving or general remark) */
  remark           String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  project   FounderProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  proposal  Proposal        @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  deliverablesRow Deliverable[]
  billingTransactions BillingTransaction[]

  @@unique([proposal_id, order_index])
  @@index([project_id])
  @@index([proposal_id])
  @@map("scd_milestones")
}

// Per-deliverable work submission (one row per deliverable within a milestone)
// Documents stored per deliverable in submitted_file; feedback stored when founder requests changes
model Deliverable {
  id                Int       @id @default(autoincrement())
  unique_id         String    @unique @default(cuid())
  milestone_id      Int
  order_index      Int       @default(0)   // 0-based within milestone
  description       String    @db.VarChar(500)
  status            String    @default("PENDING") @db.VarChar(20) // PENDING | SUBMITTED | CHANGES_REQUESTED | APPROVED
  submitted_at      DateTime? @db.Timestamptz
  submitted_remark  String?   @db.Text
  submitted_file    Json      @default("[]")    // Array of { url, name }
  approved_at       DateTime? @db.Timestamptz   // When founder approved this deliverable
  feedback          String?   @db.Text           // Founder's message when requesting changes; cleared on resubmit
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  milestone Milestone @relation(fields: [milestone_id], references: [id], onDelete: Cascade)

  @@unique([milestone_id, order_index])
  @@index([milestone_id])
  @@map("scd_deliverables")
}

// Chat: one conversation per user pair (user1, user2)
model Conversation {
  id                    Int       @id @default(autoincrement())
  unique_id             String    @unique @default(cuid())
  user1_id              Int       // smaller user id for consistent lookup
  user2_id              Int       // larger user id
  status                String?   @db.VarChar(20) // NOT_ACCEPTED | ACCEPTED | BLOCKED; null = no restriction
  blocked_by_user_id    Int?      // user who blocked (only they can unblock); null when not blocked
  user1_has_new_message Boolean   @default(false) // true when user1 has unread messages
  user2_has_new_message Boolean   @default(false) // true when user2 has unread messages
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  user1    User     @relation("ConversationUser1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2    User     @relation("ConversationUser2", fields: [user2_id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1_id, user2_id])
  @@index([user1_id, user2_id])
  @@map("scd_conversations")
}

model Message {
  id              Int       @id @default(autoincrement())
  unique_id       String    @unique @default(cuid())
  conversation_id Int
  sender_id       Int?      // null for system messages
  type            String    @db.VarChar(20) // USER | SYSTEM
  content         String    @db.Text
  metadata        Json?     // e.g. { activityType, projectId, proposalId }
  created_at      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [sender_id], references: [id], onDelete: SetNull)

  @@index([conversation_id, created_at])
  @@map("scd_messages")
}

enum OtpType {
  REGISTRATION_VERIFICATION
  LOGIN_VERIFICATION
  FORGOT_PASSWORD_VERIFICATION
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  DEACTIVATE_ACCOUNT
}

model ScheduleTermination {
  id           Int       @id @default(autoincrement())
  user_id      Int       @unique
  scheduled_at DateTime
  created_at   DateTime  @default(now())
  cancelled_at DateTime?
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([scheduled_at])
  @@map("scd_schedule_termination")
}


model ServicePackage {
  id                  Int      @id @default(autoincrement())
  unique_id           String   @unique @default(cuid())
  user_id             Int
  title               String   @db.VarChar(200)
  category_id         Int      @map("category_id")
  sub_category_id     Int?     @map("sub_category_id")
  package_description String?  @db.Text       // Rich text description from Tiptap editor

  // JSON columns for dynamic data
  features            Json     @default("[]")     // Array of feature strings
  industries          Json     @default("[]")     // Array of industry IDs
  skill_ids           Json     @default("[]")     // Array of Skill ids (scd_skills)
  scope               Json     @default("{}")     // Complex scope object with tiers
  extra_add_ons       Json     @default("[]")     // Array of extra add-ons with pricing
  deliverables        Json     @default("[]")     // Array of {deliverable, deliverDay}
  faqs                Json     @default("[]")     // Array of {question, answer}
  links               Json     @default("[]")     // Array of {url}
  requirements        Json     @default("[]")     // Array of {requirement}

  // Media fields from Gallery form
  thumbnail           String?                   // Single thumbnail URL
  images              Json     @default("[]")     // Array of image URLs
  video               Json     @default("[]")     // Array of video URLs
  documents           Json     @default("[]")     // Array of document URLs

  // Boolean flags and labels for pricing tiers
  has_basic           Boolean  @default(false)
  has_standard        Boolean  @default(false)
  has_premium         Boolean  @default(false)
  basic_label         String?  @default("Basic") @db.VarChar(50)
  standard_label      String?  @default("Standard") @db.VarChar(50)
  premium_label       String?  @default("Premium") @db.VarChar(50)

  // Status and timestamps
  status              String   @default("DRAFT") @db.VarChar(20) // DRAFT, PUBLISHED, PAUSED
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // Relations
  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category      Category     @relation(fields: [category_id], references: [id], onDelete: Restrict)
  subcategory   Subcategory? @relation(fields: [sub_category_id], references: [id], onDelete: SetNull)

  // Indexes
  @@index([user_id])
  @@index([category_id])
  @@index([sub_category_id])
  @@index([status])
  @@map("scd_service_packages")
}

model PaymentMethod {
  id                     Int      @id @default(autoincrement())
  user_id                Int
  payment_type           String   @db.VarChar(20) // 'card' or 'paypal'
  
  // Razorpay integration fields
  razorpay_customer_id   String?  @db.VarChar(255) // Razorpay customer ID
  razorpay_payment_id    String?  @db.VarChar(255) // Razorpay payment method/token ID
  card_token             String?  @db.VarChar(255) // Card token for future charges
  
  // Card display fields (for UI, not sensitive data)
  card_brand             String?  @db.VarChar(50)  // visa, mastercard, amex, etc.
  last_four_digits       String?  @db.VarChar(4)
  card_holder_name       String?  @db.VarChar(100)
  expiry_month           String?  @db.VarChar(2)
  expiry_year            String?  @db.VarChar(4)
  
  // PayPal fields
  paypal_email           String?  @db.VarChar(255)
  paypal_payer_id        String?  @db.VarChar(255)
  
  // Verification status
  is_verified            Boolean  @default(false)
  verification_amount    Decimal? @db.Decimal(10, 2)
  verified_at            DateTime?
  
  is_default             Boolean  @default(false)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([payment_type])
  @@index([is_default])
  @@index([razorpay_customer_id])
  @@map("scd_payment_methods")
}

// Bank information for freelancer payouts (one per user). Verified by cron → razorpay_fund_account_id.
model WithdrawalMethod {
  id                    Int      @id @default(autoincrement())
  unique_id             String   @unique @default(cuid())
  user_id               Int      @unique
  type                  String   @db.VarChar(20)   @default("bank_account")
  display_label         String   @db.VarChar(255)
  bank_name             String?  @db.VarChar(100)
  account_number        String?  @db.VarChar(34)
  account_number_last4  String?  @db.VarChar(4)
  ifsc                  String?  @db.VarChar(11)
  razorpay_fund_account_id String? @db.VarChar(64)
  /** pending = verification in process; verified = razorpay_fund_account_id set; failed = verification failed */
  verification_status   String   @db.VarChar(20)   @default("pending")
  /** Reason for failure when verification_status = failed; shown to user so they can fix and resubmit. */
  verification_failure_reason String? @db.VarChar(500)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  withdrawal_requests    WithdrawalRequest[]

  @@index([user_id])
  @@index([unique_id])
  @@index([verification_status])
  @@map("scd_withdrawal_methods")
}

// Withdrawal request: one row per "request withdraw" for a payment; cron processes these (status: pending → completed/failed)
model WithdrawalRequest {
  id                     Int       @id @default(autoincrement())
  user_id                Int
  withdrawal_method_id   Int
  billing_transaction_id Int       @unique
  status                 WithdrawalRequestStatus
  withdrawal_trigger_at  DateTime  @default(now())
  processed_at           DateTime?
  error_message          String?   @db.VarChar(500)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  withdrawal_method     WithdrawalMethod      @relation(fields: [withdrawal_method_id], references: [id], onDelete: Restrict)
  billing_transaction   BillingTransaction   @relation(fields: [billing_transaction_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([withdrawal_trigger_at])
  @@map("scd_withdrawal_requests")
}

model TaxInformation {
  id             Int      @id @default(autoincrement())
  user_id        Int      @unique
  tax_residence  Json
  entity_type    String   @default("INDIVIDUAL")
  pan_number     String?  @db.VarChar(10)
  individual_pan String?  @db.VarChar(10)
  individual_gstin String? @db.VarChar(15)
  agency_pan     String?  @db.VarChar(10)
  agency_gstin   String?  @db.VarChar(15)
  has_gstin      Boolean  @default(false)
  gstin          String?  @db.VarChar(15)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("scd_tax_information")
}

// Billing transaction type and status enums (use constants from @constants/status in app code)
enum BillingTransactionType {
  payment
  refund
  withdrawal
}

enum BillingTransactionStatus {
  pending
  completed
  failed
}

/** Payer (from_id) view status; receiver (to_id) view status; admin internal status. */
enum BillingTransactionSenderStatus {
  funded
  completed
  released
}

enum BillingTransactionReceiverStatus {
  pending
  completed
  released
  withdraw_in_process
  paid_out
}

enum BillingTransactionAdminStatus {
  loaded
  sent_to_freelancer
  success
}

enum WithdrawalRequestStatus {
  pending
  processing
  completed
  failed
}

model BillingTransaction {
  id              Int      @id @default(autoincrement())
  unique_id       String   @unique @default(cuid()) @db.VarChar(26)

  // WHO triggered the action
  actor_type      String   @db.VarChar(50) // User, Admin, System
  actor_id        Int

  // MONEY FROM
  from_type       String   @db.VarChar(50) // User, Platform, Wallet
  from_id         Int

  // MONEY TO
  to_type         String   @db.VarChar(50) // User, Platform, Freelancer
  to_id           Int

  // WHAT the transaction is about
  subject_type    String   @db.VarChar(50) // Project, ServicePackage, Subscription
  subject_id      Int

  /** When subject is Proposal payment, link to the milestone (null for non-milestone payments). */
  milestone_id    Int?

  amount          Decimal  @db.Decimal(10, 2)
  /** What payer paid (base + app fee + GST). Set for payment type. */
  payer_amount    Decimal? @db.Decimal(10, 2)
  /** What receiver gets (base - service fee - GST). Set for payment type. */
  receiver_amount Decimal? @db.Decimal(10, 2)
  currency_id     Int      @default(1)

  type            BillingTransactionType
  status          BillingTransactionStatus

  /** Payer (from_id) view status; UI shows this when current user is payer */
  sender_status   BillingTransactionSenderStatus?
  /** Receiver (to_id) view status; UI shows this when current user is receiver */
  receiver_status BillingTransactionReceiverStatus?
  /** Admin-only internal status */
  admin_status    BillingTransactionAdminStatus?

  description     String   @db.Text
  invoice_url     String?  @db.VarChar(500) // deprecated: use Invoice table
  meta            Json?    // deprecated: store in Invoice.meta; kept for backward compat

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  /** Payer's invoice (founder side); set when invoice is generated for payer */
  payer_invoice_id   Int?    @unique
  /** Receiver's invoice (freelancer side); set when invoice is generated for receiver */
  receiver_invoice_id Int?   @unique

  currency Currency @relation(fields: [currency_id], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  payer_invoice   Invoice?  @relation("BillingPayerInvoice", fields: [payer_invoice_id], references: [id], onDelete: SetNull)
  receiver_invoice Invoice? @relation("BillingReceiverInvoice", fields: [receiver_invoice_id], references: [id], onDelete: SetNull)
  withdrawal_request WithdrawalRequest?

  @@index([actor_type, actor_id])
  @@index([from_type, from_id])
  @@index([to_type, to_id])
  @@index([subject_type, subject_id])
  @@index([milestone_id])
  @@index([status])
  @@index([created_at])
  @@index([unique_id])
  @@map("scd_billing_transactions")
}

model Invoice {
  id                    Int      @id @default(autoincrement())
  billing_transaction_id Int
  /** payer | receiver - which party this invoice is for */
  party                 String   @db.VarChar(20)

  sender_name           String   @db.VarChar(255)
  receiver_name         String   @db.VarChar(255)
  amount                Decimal  @db.Decimal(10, 2)
  currency_code         String   @db.VarChar(10)
  description           String   @db.Text
  invoice_number        String   @unique @db.VarChar(50)
  /** Platform GSTIN (issuer) */
  gst_number            String?  @db.VarChar(50)
  /** Platform GST number (same as gst_number; explicit column for clarity) */
  platform_gst          String?  @db.VarChar(50)
  /** Sender (from_id) GST if they have one */
  sender_gst            String?  @db.VarChar(50)
  /** Receiver (to_id) GST if they have one */
  receiver_gst          String?  @db.VarChar(50)
  /** Platform/service fee amount for this transaction (e.g. receiver invoice shows fee) */
  fee                    Decimal? @db.Decimal(10, 2)
  /** GST/tax amount if applicable */
  gst_amount            Decimal? @db.Decimal(10, 2)
  file_url              String?  @db.VarChar(500)
  /** Razorpay payment/payout details; full metadata lives here */
  meta                  Json?
  issued_at             DateTime @default(now())

  created_at            DateTime @default(now())

  payer_billing_transaction   BillingTransaction? @relation("BillingPayerInvoice")
  receiver_billing_transaction BillingTransaction? @relation("BillingReceiverInvoice")

  @@index([billing_transaction_id])
  @@index([invoice_number])
  @@map("scd_invoices")
}

model LoginDevice {
  id            Int       @id @default(autoincrement())
  user_id       Int
  refresh_token String    @unique @db.VarChar(512)
  device_name   String?   @db.VarChar(255)
  device_type   String?   @db.VarChar(50)   // web, mobile, desktop
  browser       String?   @db.VarChar(100)
  os            String?   @db.VarChar(100)
  ip_address    String?   @db.VarChar(45)
  is_current    Boolean   @default(false)
  last_used_at  DateTime  @default(now())
  expires_at    DateTime
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime? // soft delete; when set, session is revoked (kept for admin)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([refresh_token])
  @@index([deleted_at])
  @@map("scd_login_devices")
}

// In-app notifications (and email sent via queue after preference check)
model Notification {
  id           Int       @id @default(autoincrement())
  user_id      Int
  type         String    @db.VarChar(80)   // NotificationEmailType
  title        String    @db.VarChar(500)
  body         String?   @db.Text
  link         String?   @db.VarChar(1024)
  read_at      DateTime?
  actor_id     Int?      // User who triggered (e.g. inviter, proposer)
  subject_type String?   @db.VarChar(80)   // FounderProject, Proposal, etc.
  subject_id   Int?
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, read_at])
  @@index([created_at])
  @@map("scd_notifications")
}

// Generic activity log (proposal, project, etc.) – replaces MongoDB activities
model Activity {
  id                Int      @id @default(autoincrement())
  subject_type      String   @db.VarChar(80)   // Proposal, FounderProject, etc.
  subject_unique_id String   @map("subject_unique_id") @db.VarChar(64)
  type              String   @db.VarChar(80)   // STATUS_CHANGE, REQUEST_MODIFY, etc.
  payload           Json     // message, oldStatus, newStatus, etc.
  created_by_user_id Int     @map("created_by_user_id")
  created_at        DateTime @default(now())

  @@index([subject_type, subject_unique_id, created_at(sort: Desc)])
  @@map("scd_activities")
}

// Central file registry: storage path + ownership + access. Business tables store attachment.unique_id (cuid).
model Attachment {
  id                  Int       @id @default(autoincrement())
  unique_id           String    @unique @db.VarChar(36)
  owner_user_id       Int
  uploaded_by_user_id Int
  disk                String    @db.VarChar(20)   // local, bunny
  path                String    @db.VarChar(512)  // opaque storage path
  visibility          String    @db.VarChar(20)   // public, private
  mime_type           String?   @db.VarChar(128)
  size_bytes          Int?
  original_name       String?   @db.VarChar(255)
  status              String    @db.VarChar(20)  @default("attached") // temporary, attached, deleted
  accessible_user_ids  Json?     // user ids who can access (e.g. NDA signer, chat participant)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  owner               User      @relation("AttachmentOwner", fields: [owner_user_id], references: [id], onDelete: Cascade)
  uploaded_by         User      @relation("AttachmentUploadedBy", fields: [uploaded_by_user_id], references: [id], onDelete: Cascade)

  @@index([owner_user_id])
  @@index([unique_id])
  @@index([status])
  @@map("scd_attachments")
}

model RedirectLink {
  id          Int      @id @default(autoincrement())
  code        String   @unique @default(cuid())
  target_url  String
  entity_type String?  // portfolio, founder_project, investor_portfolio
  entity_id   Int?
  created_by  Int?
  click_count Int      @default(0)
  created_at  DateTime @default(now())

  @@index([code])
  @@index([entity_type, entity_id])
  @@map("scd_redirect_links")
}
