generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  unique_id         String?   @unique
  first_name        String
  middle_name       String?
  last_name         String?
  email             String?   @unique
  phone             String?   @unique
  email_verified_at DateTime?
  phone_verified_at DateTime?
  password          String?
  /** ISO date (yyyy-MM-dd) of birth; UI enforces 18+ */
  dob               String?   @db.VarChar(10)
  /** 'male' | 'female' | 'other' — collected on Personal Info modal */
  gender            String?   @db.VarChar(16)
  status            Int       @default(1)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  notification      Boolean   @default(false)
  terms             Boolean   @default(true)
  googleId          String?   @unique
  linkedinId        String?   @unique
  provider          String?
  two_fa_enabled    Boolean   @default(false)
  two_fa_method     String?   // "email" | "sms"
  backup_codes      Json?     // array of bcrypt-hashed backup codes
  role              String?   
  identity_verified_at         DateTime?
  identity_verification_status String?   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  agency_verified_at           DateTime?
  otps                         Otp[]
  personalInfo                 PersonalInfo?
  companyProfile               CompanyProfile?
  education                    Education[]
  licenses                     License[]
  workExperiences              WorkExperience[]
  achievements                 Achievement[]
  expertises                   UserExpertise[]
  identityVerifications        IdentityVerification[]
  agencyVerifications          AgencyVerification[]
  founderProjects              FounderProject[]
  agency_verification_status   String?   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  show_as_agency               Boolean   @default(false)
  portfolios                   Portfolio[]
  investmentPortfolios         InvestorPortfolio[]
  investmentProfile            InvestmentProfile?
  servicePackages              ServicePackage[]
  paymentMethods               PaymentMethod[]
  bankInformation              BankInformation[]
  withdrawal_requests          WithdrawalRequest[]
  taxInformation               TaxInformation[]
  currency_id                  Int?
  currency                     Currency? @relation(fields: [currency_id], references: [id])
  experience_years              Int       @default(0)  // total years of work experience, auto-calculated
  avg_rating                    Decimal   @default(0) @db.Decimal(3, 1) // cached average of PUBLIC reviews received
  profile_completion_percentage Int?    // 0-100, cached from preference.profile_sections + role weights
  preference                    UserPreference?
  wallet                        UserWallet?
  projectInvites               ProjectInvite[] @relation("ProjectInvites")
  savedProjects                SavedProject[] @relation("SavedProjects")
  savedMentors                 SavedMentor[] @relation("SavedMentors")
  savedAsMentor                SavedMentor[] @relation("SavedAsMentor")
  mentorOnRequest              MentorOnRequest?
  availability                 Availability?
  mentorPackages               MentorPackage[]
  proposals                    Proposal[] @relation("UserProposals")
  reviewsGiven                 Review[]   @relation("ReviewsGiven")
  reviewsReceived              Review[]   @relation("ReviewsReceived")
  reportsGiven                 ReportSpam[] @relation("ReportsGiven")
  reportsReceived              ReportSpam[] @relation("ReportsReceived")
  conversationsAsUser1        Conversation[] @relation("ConversationUser1")
  conversationsAsUser2         Conversation[] @relation("ConversationUser2")
  sentMessages                 Message[]
  loginDevices                 LoginDevice[]
  notifications                Notification[] @relation("UserNotifications")
  actedNotifications           Notification[] @relation("NotificationActor")
  is_deactivated               Boolean   @default(false)
  deactivated_at               DateTime?
  deactivated_reason           String?   @db.Text
  startupProgress              UserStartupProgress?
  scheduleTermination          ScheduleTermination?
  razorpay_contact_id          String?   @db.VarChar(64)
  /** Razorpay Route linked account id (acc_xxx) for individual payouts (set after bank verification). */
  razorpay_account_id          String?   @db.VarChar(64)
  /** Razorpay Route linked account id (acc_xxx) for agency payouts (set after agency bank verification). */
  razorpay_agency_account_id   String?   @db.VarChar(64)
  successStories               SuccessStory[]
  bookingsAsMentor             Booking[] @relation("BookingMentor")
  bookingsAsUser               Booking[] @relation("BookingUser")
  bookingActivities            BookingActivity[] @relation("BookingActivityActor")
  attachmentsOwned              Attachment[] @relation("AttachmentOwner")
  attachmentsUploaded          Attachment[] @relation("AttachmentUploadedBy")
  /** Temporary state token for DigiLocker OAuth callback validation */
  digilocker_state             String?      @db.VarChar(64)
  /** Google Calendar OAuth: encrypted refresh token */
  google_calendar_refresh_token String?     @db.Text
  /** Google Calendar: email of the connected account */
  google_calendar_email         String?     @db.VarChar(255)
  /** Google Calendar: when the user connected their calendar */
  google_calendar_connected_at  DateTime?
  /** Zoom OAuth */
  zoom_refresh_token            String?     @db.Text
  zoom_email                    String?     @db.VarChar(255)
  zoom_connected_at             DateTime?
  /** Microsoft Teams OAuth */
  ms_teams_refresh_token        String?     @db.Text
  ms_teams_email                String?     @db.VarChar(255)
  ms_teams_connected_at         DateTime?
  /** Tracks when the user last updated their name (15-day cooldown) */
  name_updated_at               DateTime?
  connectionsSent               Connection[] @relation("ConnectionSender")
  connectionsReceived           Connection[] @relation("ConnectionReceiver")
  blockedUsers                  BlockedUser[] @relation("BlockedByUser")
  blockedByUsers                BlockedUser[] @relation("BlockedTargetUser")
  passwordHistory               PasswordHistory[]
  bugReports                    BugReport[] @relation("BugReportsGiven")
  @@index([email, phone])
  @@index([last_name, first_name, email])
  @@index([googleId])
  @@index([linkedinId])
  @@map("scd_users")
}

/**
 * Append-only log of every bcrypt password hash a user has ever used.
 * Acts as both the audit trail for password changes and the source for
 * reuse-prevention checks on update / reset / set flows.
 */
model PasswordHistory {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /** bcrypt hash — never compare with === ; always use bcrypt.compare */
  password    String
  /** Where the change originated: 'update' | 'reset' | 'set' | 'register' */
  source      String
  ip_address  String?  @db.VarChar(64)
  user_agent  String?  @db.Text
  created_at  DateTime @default(now())
  @@index([user_id, created_at])
  @@map("scd_password_history")
}

/** Section completion + email notification preferences (moved off User). */
model UserPreference {
  id                            Int      @id @default(autoincrement())
  user_id                       Int      @unique
  /** Role-based profile section completion: { [sectionKey]: boolean }. */
  profile_sections               Json?
  /** Per-type email preference: { [NotificationEmailType]: boolean }. false = do not send. */
  email_notification_preferences Json?
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt

  user                          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@map("scd_user_preferences")
}

/** Wallet and billing totals (moved off User). One row per user. */
model UserWallet {
  id                Int      @id @default(autoincrement())
  user_id           Int      @unique
  wallet_amount     Decimal  @db.Decimal(15, 2) @default(0)  // current balance
  total_earning     Decimal  @db.Decimal(15, 2) @default(0)  // sum of completed credits received
  total_withdrawal  Decimal  @db.Decimal(15, 2) @default(0)  // sum of completed withdrawals
  pending_amount    Decimal  @db.Decimal(15, 2) @default(0)  // sum of pending credits to be received
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@map("scd_user_wallets")
}

// Personal Info - Common for all user types
model PersonalInfo {
  id                    Int       @id @default(autoincrement())
  user_id               Int       @unique
  // Profile fields
  profileImage          String?
  coverImage            String?
  hideEmail             Boolean   @default(false)
  hidePhone             Boolean   @default(false)
  title                 String?
  about                 String?
  address               String?
  address_line_2        String?
  city                  String?
  website               String?
  zipCode               String?
  hourly_rate           Float?
  available_hours_per_week Int?
  links                 Json?     // Social media links
  languages             Json?
  show_as_agency        Boolean   @default(false)
  keycode               String?   @unique // Unique keycode for identity verification
  // Relations
  country_id            Int?
  state_id              Int?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  country               Country?  @relation(fields: [country_id], references: [id])
  state                 State?    @relation(fields: [state_id], references: [id])

  @@index([user_id])
  @@map("scd_personal_info")
}

// Company/Founder Profile
model CompanyProfile {
  id                    Int       @id @default(autoincrement())
  user_id               Int       @unique
  unique_id             String    @unique
  
  // Profile fields
  profileImage          String?
  coverImage            String?
  
  // Company information
  company_name          String?
  company_description   String?
  company_website       String?
  cin                   String?
  company_size          String?
  founded_year          Int?
  company_stage         String?
  business_model        String?
  team_size             Int?
  
  // Business model
  revenue_models        Json?     // [{ name, is_primary, is_secondary }]
  revenue_description   String?   @db.Text
  target_market         String?
  problem_statement     String?
  solution_statement    String?
  
  // Traction
  traction_title        String?
  traction_document     String?
  
  // Funding
  funding_status        String?
  total_funding         Decimal?  @db.Decimal(15, 2)
  
  // Location (Headquarters)
  is_registered         Boolean   @default(false)
  address               String?
  address_line_2        String?
  city                  String?
  zipCode               String?

  // Branch Office
  is_branch_same_as_hq  Boolean   @default(false)
  branch_address        String?
  branch_address_line_2 String?
  branch_city           String?
  branch_zipCode        String?
  
  // Pitch deck
  founders_video_url    String?
  cap_table_url         String?
  cap_table_file        String?               // Attachment unique_id
  product_demo_url      String?

  // Social links
  links                 Json?
  
  // Relations
  country_id            Int?
  state_id              Int?
  branch_country_id     Int?
  branch_state_id       Int?
  industry_id           Int?
  sub_industry_id       Int?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  country               Country?  @relation("hq_country", fields: [country_id], references: [id])
  state                 State?    @relation("hq_state", fields: [state_id], references: [id])
  branchCountry         Country?  @relation("branch_country", fields: [branch_country_id], references: [id])
  branchState           State?    @relation("branch_state", fields: [branch_state_id], references: [id])
  industry              Industry? @relation(fields: [industry_id], references: [id])
  subIndustry           SubIndustry? @relation(fields: [sub_industry_id], references: [id])
  teamMembers           TeamMember[]
  fundingRounds         FundingRound[]
  raisingFund           RaisingFund?

  @@index([unique_id])
  @@index([user_id])
  @@map("scd_company_profiles")
}

model FundingRound {
  id                    Int       @id @default(autoincrement())
  company_profile_id    Int
  investor_name         String
  funding_stage         String
  funding_amount        Decimal   @db.Decimal(15, 2)
  funding_date          DateTime
  funding_valuation     Decimal?  @db.Decimal(15, 2)
  deleted_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  companyProfile        CompanyProfile @relation(fields: [company_profile_id], references: [id], onDelete: Cascade)

  @@index([company_profile_id])
  @@map("scd_funding_rounds")
}

model RaisingFund {
  id                    Int       @id @default(autoincrement())
  company_profile_id    Int       @unique
  is_raising            Boolean   @default(false)
  funding_stage         String?                          // Exploring, Preparing, Actively raising, etc.
  round_type            String?
  target_amount         Decimal?  @db.Decimal(15, 2)
  expected_close_date   String?                          // ISO date string
  valuation_min         Decimal?  @db.Decimal(15, 2)
  valuation_max         Decimal?  @db.Decimal(15, 2)
  has_committed         Boolean?  @default(false)
  committed_amount      Decimal?  @db.Decimal(15, 2)
  committed_investor    String?                          // Investor/firm name
  uses_of_fund          Json?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  companyProfile        CompanyProfile @relation(fields: [company_profile_id], references: [id], onDelete: Cascade)

  @@map("scd_raising_funds")
}

model Education {
  id            Int      @id @default(autoincrement())
  user_id       Int
  school        String
  degree        String
  area_of_study String
  start_month   String
  start_year    String
  end_month     String?
  end_year      String?
  is_ongoing    Boolean  @default(false)
  description   String?
  skills        Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_education")
}

model License {
  id               Int      @id @default(autoincrement())
  user_id          Int
  institute        String
  license_name     String
  completed_month  String
  completed_year   String
  description      String?
  skills           Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_licenses")
}

model Category {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  description     String?
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  expertises      UserExpertise[]
  subcategories   Subcategory[]
  skills          Skill[]
  founderProjects FounderProject[]
  servicePackages ServicePackage[]
  mentorPackages  MentorPackage[]

  @@map("scd_expertise_categories")
}

model Subcategory {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  categoryId    Int       @map("expertise_category_id")
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  category      Category  @relation(fields: [categoryId], references: [id])
  founderProjects FounderProject[]
  servicePackages ServicePackage[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("scd_specialties")
}

model Skill {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  categoryId  Int      @map("expertise_category_id")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("scd_skills")
}

model Industry {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  portfolios      Portfolio[]
  investorPortfolios InvestorPortfolio[]
  subIndustries   SubIndustry[]
  companyProfiles CompanyProfile[]
  investmentProfilePreferredIndustries InvestmentProfilePreferredIndustry[]

  @@map("scd_industries")
}

model SubIndustry {
  id              Int              @id @default(autoincrement())
  industry_id     Int
  name            String
  description     String?
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  industry        Industry         @relation(fields: [industry_id], references: [id], onDelete: Cascade)
  companyProfiles CompanyProfile[]
  investorPortfolios InvestorPortfolio[]
  investmentProfilePreferredIndustries InvestmentProfilePreferredIndustry[]

  @@unique([industry_id, name])
  @@index([industry_id])
  @@map("scd_sub_industries")
}

model BusinessModel {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("scd_business_models")
}

/// Generic admin-managed option lists (reasons, stages, models, etc.).
/// Each row is ONE selectable option. Consuming records store the `value`
/// text verbatim — never this row's id. `subkey` namespaces a group into
/// sub-lists (e.g. proposal_reason → "withdrawOffer", meeting_reason → "CANCEL");
/// it is "" when the group has a single flat list. `code`/`label`/`description`
/// support object-shaped lists (investor_type, id_type); for plain string lists
/// `value` is used as both display and stored value.
model Constant {
  id          Int      @id @default(autoincrement())
  group       String   @db.VarChar(64)   // e.g. startup_stage, revenue_model, proposal_reason
  subkey      String   @default("") @db.VarChar(64) // sub-list key; "" = flat list
  value       String   @db.VarChar(255)  // the text actually stored on consuming records
  label       String?  @db.VarChar(255)  // display label (defaults to value when null)
  description String?  @db.Text
  code        String?  @db.VarChar(64)   // optional slug/id for object-shaped options
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([group, subkey, value])
  @@index([group, subkey, is_active])
  @@map("scd_constants")
}

model TeamMember {
  id                Int       @id @default(autoincrement())
  unique_id         String    @unique @default(cuid())
  company_profile_id Int
  name              String
  email             String?
  role              String
  is_cofounder      Boolean   @default(false)
  bio               String?
  profile_image     String?
  linkedin_url      String?
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  companyProfile    CompanyProfile @relation(fields: [company_profile_id], references: [id], onDelete: Cascade)

  @@index([company_profile_id])
  @@index([unique_id])
  @@map("scd_team_members")
}

model UserExpertise {
  id            Int         @id @default(autoincrement())
  user_id       Int
  categoryId    Int         @map("expertise_category_id")
  specialty_ids Json?
  description   String?
  skills        Json?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  user          User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id])

  @@map("scd_user_expertises")
}

model Otp {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  email      String?
  phone      String?
  otp_code   String
  otp_type   OtpType
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email, otp_type, verified])
  @@index([phone, otp_type, verified])
  @@index([expires_at])
  @@map("scd_otps")
}

model Country {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  code               String              @unique
  phone_code         String?             // Phone country code like +91, +1, +44
  flag               String?
  /** Admin-managed: inactive countries stay referencable by existing rows but are hidden from public pickers. */
  is_active          Boolean             @default(true)
  currency_id        Int?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  currency           Currency?           @relation(fields: [currency_id], references: [id])
  states             State[]
  personalInfos      PersonalInfo[]
  companyProfiles    CompanyProfile[]    @relation("hq_country")
  companyBranchProfiles CompanyProfile[] @relation("branch_country")
  investmentProfileGeoPreferences InvestmentProfileGeoPreference[]

  @@map("scd_countries")
}

model State {
  id                 Int                 @id @default(autoincrement())
  name               String
  code               String?
  country_id         Int
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  country            Country             @relation(fields: [country_id], references: [id], onDelete: Cascade)
  personalInfos      PersonalInfo[]
  companyProfiles    CompanyProfile[]    @relation("hq_state")
  companyBranchProfiles CompanyProfile[] @relation("branch_state")
  investmentProfileGeoPreferences InvestmentProfileGeoPreference[]

  @@unique([name, country_id])
  @@map("scd_states")
}

model Currency {
  id                  Int                   @id @default(autoincrement())
  name                String                @unique
  code                String                @unique
  symbol              String
  exchange_rate       Decimal               @default(1.0) @db.Decimal(10, 6) // Exchange rate to USD (1 USD = X currency)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  countries           Country[]
  users               User[]
  billingTransactions BillingTransaction[]
  bookings            Booking[]

  @@map("scd_currencies")
}

model Language {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  native_name  String?
  code         String   @unique
  country_code String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("scd_languages")
}

model WorkExperience {
  id                Int      @id @default(autoincrement())
  user_id           Int
  role              String
  company           String
  company_website   String?
  description       String?
  start_month       String
  start_year        String
  end_month         String?
  end_year          String?
  is_current        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_work_experiences")
}

model Achievement {
  id                Int      @id @default(autoincrement())
  user_id           Int
  title             String
  description       String?
  company           String
  completed_month   String
  completed_year    String
  achievement_link  String?
  media_files       Json?    // Array of media file objects with type, url, name
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_achievements")
}

model IdentityVerification {
  id                        Int       @id @default(autoincrement())
  user_id                   Int
  verification_type         String    // "aadhaar" | "driving-license" — document verified via DigiLocker
  status                    String    @default("PENDING") // PENDING, APPROVED, REJECTED
  meta_data                 Json?     // All details received from DigiLocker after verification (name, dob, gender, address, uid, image, etc.)
  submitted_at              DateTime?
  verified_at               DateTime?
  rejection_reason          String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  user                      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([status])
  @@map("scd_identity_verifications")
}

model AgencyVerification {
  id                Int       @id @default(autoincrement())
  user_id           Int
  agency_name       String
  cin               String    // Corporate Identification Number
  document_urls     Json?     // Array of document URLs
  status            String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  submitted_at      DateTime?
  verified_at       DateTime?
  verified_by       Int?
  rejection_reason  String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([status])
  @@map("scd_agency_verifications")
}

model Portfolio {
  id                 Int       @id @default(autoincrement())
  unique_id          String    @unique @default(cuid())
  user_id            Int
  title              String?
  description        String?   @db.Text
  company_name       String?
  hide_company_name  Boolean   @default(false)
  industry_id        Int?
  role               String?
  project_skills     Json?     // Array of skill names
  thumbnail_url      String?   // Single thumbnail image URL
  media_urls         Json?     // Array of media file URLs
  project_link       String?
  completion_month   String?
  completion_year    String?
