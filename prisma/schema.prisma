generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  first_name        String
  last_name         String?
  email             String?   @unique
  phone             String?   @unique
  email_verified_at DateTime?
  phone_verified_at DateTime?
  password          String?
  status            Int       @default(1)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  notification      Boolean   @default(false)
  terms             Boolean   @default(true)
  googleId          String?   @unique
  linkedinId        String?   @unique
  profileImage      String?
  provider          String?
  coverImage        String?
  hideEmail                    Boolean   @default(false)
  hidePhone                    Boolean   @default(false)
  identity_verified_at         DateTime?
  identity_verification_status String?   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  agency_verified_at           DateTime?
  unique_id                    String    @unique
  otps                         Otp[]
  personalInfo                 PersonalInfo?
  education                    Education[]
  licenses                     License[]
  workExperiences              WorkExperience[]
  achievements                 Achievement[]
  expertises                   UserExpertise[]
  identityVerifications        IdentityVerification[]
  agencyVerifications          AgencyVerification[]
  agency_verification_status   String?   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  show_as_agency               Boolean   @default(false)
  portfolios                   Portfolio[]
  servicePackages              ServicePackage[]
  paymentMethods               PaymentMethod[]
  taxInformation               TaxInformation?

  @@index([email, phone])
  @@index([last_name, first_name, email])
  @@index([googleId])
  @@index([linkedinId])
  @@map("scd_users")
}

model PersonalInfo {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  title          String?
  about          String?
  address        String?
  address_line_2 String?
  city           String?
  website        String?
  zipCode        String?
  hourly_rate    Float?
  links          Json?
  currency_id    Int?
  country_id     Int?
  state_id       Int?
  languages          Json?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  currency       Currency? @relation(fields: [currency_id], references: [id])
  country        Country?  @relation(fields: [country_id], references: [id])
  state          State?    @relation(fields: [state_id], references: [id])

  @@map("scd_personal_info")
}

model Education {
  id            Int      @id @default(autoincrement())
  user_id       Int
  school        String
  degree        String
  area_of_study String
  start_month   String
  start_year    String
  end_month     String?
  end_year      String?
  is_ongoing    Boolean  @default(false)
  description   String?
  skills        Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_education")
}

model License {
  id               Int      @id @default(autoincrement())
  user_id          Int
  institute        String
  license_name     String
  completed_month  String
  completed_year   String
  description      String?
  skills           Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_licenses")
}

model ExpertiseCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  is_active   Boolean         @default(true)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  expertises  UserExpertise[]
  specialties Specialty[]
  skills      Skill[]

  @@map("scd_expertise_categories")
}

model Specialty {
  id                    Int               @id @default(autoincrement())
  name                  String
  description           String?
  expertise_category_id Int
  is_active             Boolean           @default(true)
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  expertiseCategory     ExpertiseCategory @relation(fields: [expertise_category_id], references: [id])
  expertises            UserExpertise[]

  @@unique([name, expertise_category_id])
  @@map("scd_specialties")
}

model Skill {
  id                    Int               @id @default(autoincrement())
  name                  String
  description           String?
  expertise_category_id Int
  is_active             Boolean           @default(true)
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  expertiseCategory     ExpertiseCategory @relation(fields: [expertise_category_id], references: [id])

  @@unique([name, expertise_category_id])
  @@map("scd_skills")
}

model Industry {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  portfolios  Portfolio[]

  @@map("scd_industries")
}

model UserExpertise {
  id                    Int               @id @default(autoincrement())
  user_id               Int
  expertise_category_id Int
  specialty_id          Int
  description           String?
  skills                Json? // Array of skill names
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  user                  User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expertiseCategory     ExpertiseCategory @relation(fields: [expertise_category_id], references: [id])
  specialty             Specialty         @relation(fields: [specialty_id], references: [id])

  @@map("scd_user_expertises")
}

model Otp {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  email      String?
  phone      String?
  otp_code   String
  otp_type   OtpType
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email, otp_type, verified])
  @@index([phone, otp_type, verified])
  @@index([expires_at])
  @@map("scd_otps")
}

model Country {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  code         String         @unique
  phone_code   String?        // Phone country code like +91, +1, +44
  flag         String?
  currency_id  Int?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  currency     Currency?      @relation(fields: [currency_id], references: [id])
  states       State[]
  personalInfo PersonalInfo[]

  @@map("scd_countries")
}

model State {
  id           Int            @id @default(autoincrement())
  name         String
  code         String?
  country_id   Int
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  country      Country        @relation(fields: [country_id], references: [id], onDelete: Cascade)
  personalInfo PersonalInfo[]

  @@unique([name, country_id])
  @@map("scd_states")
}

model Currency {
  id                  Int                   @id @default(autoincrement())
  name                String                @unique
  code                String                @unique
  symbol              String
  exchange_rate       Decimal               @default(1.0) @db.Decimal(10, 6) // Exchange rate to USD (1 USD = X currency)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  countries           Country[]
  personalInfo        PersonalInfo[]
  billingTransactions BillingTransaction[]

  @@map("scd_currencies")
}

model Language {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  native_name  String?
  code         String   @unique
  country_code String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("scd_languages")
}

model WorkExperience {
  id                Int      @id @default(autoincrement())
  user_id           Int
  role              String
  company           String
  company_website   String?
  description       String?
  start_month       String
  start_year        String
  end_month         String?
  end_year          String?
  is_current        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_work_experiences")
}

model Achievement {
  id                Int      @id @default(autoincrement())
  user_id           Int
  title             String
  description       String?
  company           String
  completed_month   String
  completed_year    String
  achievement_link  String?
  media_files       Json?    // Array of media file objects with type, url, name
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_achievements")
}

model IdentityVerification {
  id                        Int       @id @default(autoincrement())
  user_id                   Int
  first_name                String
  last_name                 String
  date_of_birth             DateTime
  nationality               String?
  id_type                   String    // passport, driver_license, national_id, etc.
  id_number                 String
  id_expiry_date            DateTime?
  issuing_country           String
  id_document_urls          Json      // Array of document image URLs
  selfie_urls               Json      // Array of selfie image URLs
  address_line_1            String
  address_line_2            String?
  city                      String
  state                     String?
  postal_code               String?
  address_country           String
  proof_of_address_consent  String?
  address_proof_urls        Json?     // Array of address proof document URLs
  document_type             String?   // bank-statement, utility-bill
  institution_name          String?   // Bank or utility company name
  document_date_issued      DateTime? // Date when document was issued
  status                    String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  submitted_at              DateTime?
  reviewed_at               DateTime?
  reviewed_by               Int?
  rejection_reason          String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  user                      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([status])
  @@map("scd_identity_verifications")
}

model AgencyVerification {
  id                Int       @id @default(autoincrement())
  user_id           Int
  agency_name       String
  cin               String    // Corporate Identification Number
  document_urls     Json?     // Array of document URLs
  status            String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  submitted_at      DateTime?
  verified_at       DateTime?
  reviewed_by       Int?
  rejection_reason  String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([status])
  @@map("scd_agency_verifications")
}

model Portfolio {
  id                 Int       @id @default(autoincrement())
  unique_id          String    @unique @default(uuid())
  user_id            Int
  title              String
  description        String    @db.Text
  company_name       String
  hide_company_name  Boolean   @default(false)
  industry_id        Int
  role               String?
  project_skills     Json      // Array of skill names
  thumbnail_url      String?   // Single thumbnail image URL
  media_urls         Json?     // Array of media file URLs
  project_link       String?
  completion_month   String
  completion_year    String
  references         Json?     // Array of reference URLs
  status             String    @default("DRAFT") // DRAFT, PUBLISHED
  deleted_at         DateTime? // Soft delete timestamp
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  industry           Industry  @relation(fields: [industry_id], references: [id])

  @@index([user_id, status])
  @@index([status])
  @@index([industry_id])
  @@index([deleted_at])
  @@map("scd_portfolios")
}

enum OtpType {
  REGISTRATION_VERIFICATION
  LOGIN_VERIFICATION
  FORGOT_PASSWORD_VERIFICATION
  PHONE_VERIFICATION
}


model ServiceCategory {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(100)
  description   String?  @db.Text
  icon          String?  @db.VarChar(100)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Relations
  subCategories   ServiceSubCategory[]
  keywords        ServiceKeyword[]
  servicePackages ServicePackage[]
  
  // Indexes
  @@index([is_active])
  @@map("scd_service_categories")
}

model ServiceSubCategory {
  id          Int      @id @default(autoincrement())
  category_id Int
  name        String   @db.VarChar(100)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  // Relations
  category        ServiceCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  keywords        ServiceKeyword[]
  servicePackages ServicePackage[]
  
  // Indexes
  @@index([category_id])
  @@index([is_active])
  @@unique([category_id, name], name: "category_id_name")
  @@map("scd_service_sub_categories")
}

model ServiceKeyword {
  id               Int      @id @default(autoincrement())
  category_id      Int
  sub_category_id  Int?
  name             String   @db.VarChar(100)
  popularity_score Int      @default(0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  
  // Relations
  category         ServiceCategory    @relation(fields: [category_id], references: [id], onDelete: Cascade)
  subCategory      ServiceSubCategory? @relation(fields: [sub_category_id], references: [id], onDelete: SetNull)
  
  // Indexes
  @@index([category_id])
  @@index([sub_category_id])
  @@index([is_active])
  @@index([popularity_score])
  @@index([name])
  @@unique([category_id, name], name: "category_id_name")
  @@map("scd_service_keywords")
}

model ServicePackage {
  id                  Int      @id @default(autoincrement())
  unique_id           String   @unique
  user_id             Int
  title               String   @db.VarChar(200)
  category_id         Int
  sub_category_id     Int?
  package_description String?  @db.Text       // Rich text description from Tiptap editor
  
  // JSON columns for dynamic data
  features            Json     @default("[]")     // Array of feature strings
  industries          Json     @default("[]")     // Array of industry IDs
  keywords            Json     @default("[]")     // Array of keyword IDs
  scope               Json     @default("{}")     // Complex scope object with tiers
  extra_add_ons       Json     @default("[]")     // Array of extra add-ons with pricing
  deliverables        Json     @default("[]")     // Array of {deliverable, deliverDay}
  faqs                Json     @default("[]")     // Array of {question, answer}
  links               Json     @default("[]")     // Array of {url}
  requirements        Json     @default("[]")     // Array of {requirement}
  
  // Media fields from Gallery form
  thumbnail           String?                   // Single thumbnail URL
  images              Json     @default("[]")     // Array of image URLs
  video               Json     @default("[]")     // Array of video URLs
  documents           Json     @default("[]")     // Array of document URLs
  
  // Boolean flags for pricing tiers
  has_basic           Boolean  @default(false)
  has_standard        Boolean  @default(false)
  has_premium         Boolean  @default(false)
  
  // Status and timestamps
  status              String   @default("DRAFT") @db.VarChar(20) // DRAFT, PUBLISHED, PAUSED
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  
  // Relations
  user                User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category            ServiceCategory     @relation(fields: [category_id], references: [id], onDelete: Restrict)
  subCategory         ServiceSubCategory? @relation(fields: [sub_category_id], references: [id], onDelete: SetNull)
  
  // Indexes
  @@index([user_id])
  @@index([category_id])
  @@index([sub_category_id])
  @@index([status])
  @@map("scd_service_packages")
}


model uploadFile {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  path       String   @db.VarChar(500)
  mime_type  String   @db.VarChar(100)
  status     String   @default("UNATTACH") @db.VarChar(20)
  created_at DateTime @default(now())
  @@map("scd_upload_files")
  @@index([created_at])
  @@index([mime_type])
  @@index([mime_type,path])
}

model PaymentMethod {
  id                     Int      @id @default(autoincrement())
  user_id                Int
  payment_type           String   @db.VarChar(20) // 'card' or 'paypal'
  
  // Razorpay integration fields
  razorpay_customer_id   String?  @db.VarChar(255) // Razorpay customer ID
  razorpay_payment_id    String?  @db.VarChar(255) // Razorpay payment method/token ID
  card_token             String?  @db.VarChar(255) // Card token for future charges
  
  // Card display fields (for UI, not sensitive data)
  card_brand             String?  @db.VarChar(50)  // visa, mastercard, amex, etc.
  last_four_digits       String?  @db.VarChar(4)
  card_holder_name       String?  @db.VarChar(100)
  expiry_month           String?  @db.VarChar(2)
  expiry_year            String?  @db.VarChar(4)
  
  // PayPal fields
  paypal_email           String?  @db.VarChar(255)
  paypal_payer_id        String?  @db.VarChar(255)
  
  // Verification status
  is_verified            Boolean  @default(false)
  verification_amount    Decimal? @db.Decimal(10, 2)
  verified_at            DateTime?
  
  is_default             Boolean  @default(false)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([payment_type])
  @@index([is_default])
  @@index([razorpay_customer_id])
  @@map("scd_payment_methods")
}

model TaxInformation {
  id             Int      @id @default(autoincrement())
  user_id        Int      @unique
  tax_residence  Json
  has_gstin      Boolean  @default(false)
  gstin          String?  @db.VarChar(15)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("scd_tax_information")
}

model BillingTransaction {
  id              Int      @id @default(autoincrement())
  unique_id       String   @unique @db.VarChar(26)

  // WHO triggered the action
  actor_type      String   @db.VarChar(50) // User, Admin, System
  actor_id        Int

  // MONEY FROM
  from_type       String   @db.VarChar(50) // User, Platform, Wallet
  from_id         Int

  // MONEY TO
  to_type         String   @db.VarChar(50) // User, Platform, Freelancer
  to_id           Int

  // WHAT the transaction is about
  subject_type    String   @db.VarChar(50) // Project, ServicePackage, Subscription
  subject_id      Int

  amount          Decimal  @db.Decimal(10, 2)
  currency_id     Int      @default(1)

  type            String   @db.VarChar(30) // payment, refund, withdrawal
  status          String   @db.VarChar(20) // pending, completed, failed

  description     String   @db.Text
  invoice_url     String?  @db.VarChar(500)

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  currency Currency @relation(fields: [currency_id], references: [id], onDelete: Cascade)
  meta     BillingTransactionMeta[]

  @@index([actor_type, actor_id])
  @@index([from_type, from_id])
  @@index([to_type, to_id])
  @@index([subject_type, subject_id])
  @@index([status])
  @@index([created_at])
  @@index([unique_id])
  @@map("scd_billing_transactions")
}

model BillingTransactionMeta {
  id              Int      @id @default(autoincrement())
  transaction_id  Int
  key             String   @db.VarChar(100)
  value           String   @db.Text

  transaction BillingTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([transaction_id])
  @@index([key])
  @@map("scd_billing_transaction_meta")
}
