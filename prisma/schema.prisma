// Investment profile - one per user (investor); single-value details and links to detail tables
model InvestmentProfile {
  id                      Int       @id @default(autoincrement())
  unique_id               String    @unique @default(cuid())
  user_id                 Int       @unique

  // Single-value fields (investor type, thesis, diligence, ticket size, equity range)
  investor_types          Json?     // ["Angel investor", "Micro VCs"] - selected values from constants
  thesis_summary          String?   @db.Text
  diligence_process       String?   @db.Text
  diligence_document      String?   // file path
  investment_size_min     Decimal?  @db.Decimal(15, 2)
  investment_size_max     Decimal?  @db.Decimal(15, 2)
  investment_size_currency String?  // USD, INR
  equity_range_min       Int?      // percentage 0-100
  equity_range_max       Int?      // percentage 0-100

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  user                    User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  preferredIndustries      InvestmentProfilePreferredIndustry[]
  committeeMembers        InvestmentProfileCommitteeMember[]
  geoPreferences          InvestmentProfileGeoPreference[]

  @@index([user_id])
  @@map("scd_investment_profiles")
}

// Preferred investment industry - many per profile (industry + optional specialisation, stage, criteria)
model InvestmentProfilePreferredIndustry {
  id                    Int       @id @default(autoincrement())
  investment_profile_id Int
  industry_id           Int
  sub_industry_id       Int?
  specialisation        String?   @db.VarChar(500)
  investment_stage     String?   @db.VarChar(255)
  investment_criteria   String?   @db.Text
  order_index          Int       @default(0)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  investmentProfile     InvestmentProfile @relation(fields: [investment_profile_id], references: [id], onDelete: Cascade)
  industry              Industry         @relation(fields: [industry_id], references: [id], onDelete: Cascade)
  subIndustry           SubIndustry?      @relation(fields: [sub_industry_id], references: [id], onDelete: SetNull)

  @@index([investment_profile_id])
  @@index([industry_id])
  @@map("scd_investment_profile_preferred_industries")
}

// Investment committee structure - many members per profile
model InvestmentProfileCommitteeMember {
  id                    Int       @id @default(autoincrement())
  unique_id             String    @unique @default(cuid())
  investment_profile_id Int
  name                  String    @db.VarChar(255)
  role                  String?   @db.VarChar(255)   // e.g. Founder & CEO, CEO, CTO
  role_description      String?   @db.Text
  photo                 String?   // file path
  email                 String?   @db.VarChar(255)
  hide_email            Boolean   @default(false)
  order_index           Int       @default(0)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  investmentProfile     InvestmentProfile @relation(fields: [investment_profile_id], references: [id], onDelete: Cascade)

  @@index([investment_profile_id])
  @@map("scd_investment_profile_committee_members")
}

// Geographic preference - many country/state entries per profile
model InvestmentProfileGeoPreference {
  id                    Int       @id @default(autoincrement())
  investment_profile_id Int
  country_id            Int
  state_id              Int?
  order_index           Int       @default(0)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  investmentProfile     InvestmentProfile @relation(fields: [investment_profile_id], references: [id], onDelete: Cascade)
  country               Country          @relation(fields: [country_id], references: [id], onDelete: Cascade)
  state                 State?           @relation(fields: [state_id], references: [id], onDelete: SetNull)

  @@index([investment_profile_id])
  @@index([country_id])
  @@map("scd_investment_profile_geo_preferences")
}

model FounderProject {
  id                    Int       @id @default(autoincrement())
  unique_id             String    @unique @default(cuid())
  user_id               Int
  project_title         String    @db.VarChar(100)
  project_description   String?   @db.Text
  expertise_category_id Int?
  specialty_id          Int?
  project_files         Json      @default("[]")
  scope_of_work         String?   @db.Text
  skills_required       Json      @default("[]")
  experience_needed     String?   @db.VarChar(50)
  budget_currency       String?   @db.VarChar(10)
  budget_amount         String?   @db.VarChar(20)
  is_nda_required       Boolean   @default(false)
  screening_questions   Json      @default("[]")
  advanced_preferences  Json
  status                String    @default("DRAFT")
  invited_count         Int       @default(0)
  proposals_count       Int       @default(0)
  hired_count           Int       @default(0)
  saved_providers       Json      @default("[]") // Array of provider user IDs saved for later
  deleted_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [expertise_category_id], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [specialty_id], references: [id], onDelete: SetNull)
