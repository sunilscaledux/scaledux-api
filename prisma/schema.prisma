datasource db {
    provider = "postgresql"
    url      = env("POSTGRES_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id                Int       @id @default(autoincrement())
    uniqueId          String    @unique
    FirstName         String
    LastName          String?
    email             String?   @unique
    phone             String?   @unique
    email_verified_at DateTime?
    phone_verified_at DateTime?
    password          String?
    status            Int       @default(1)
    created_at        DateTime  @default(now())
    updated_at        DateTime  @updatedAt
    notification      Boolean   @default(false)
    terms             Boolean   @default(true)
    googleId          String?   @unique
    linkedinId        String?   @unique
    profileImage      String?
    provider          String?
    coverImage        String?
    hideEmail         Boolean   @default(false)
    hidePhone         Boolean   @default(false)
    title             String?
    about             String?
    address           String?
    address_line_2    String?
    zipCode           String?
    countryId         Int?
    stateId           Int?
    city              String?
    website           String?
    links             Json?
    
    // Relations
    country           Country? @relation(fields: [countryId], references: [id])
    state             State?   @relation(fields: [stateId], references: [id])
    
    otps     Otp[]
    @@index([email, phone])
    @@index([LastName, FirstName, email])
    @@index([googleId])
    @@index([linkedinId])
    @@map("users")
}

model Otp {
    id         Int      @id @default(autoincrement())
    user_id    Int?
    email      String?
    phone      String?
    otp_code   String
    otp_type   OtpType
    expires_at DateTime
    verified   Boolean  @default(false)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relations
    user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@index([email, otp_type, verified])
    @@index([phone, otp_type, verified])
    @@index([expires_at])
    @@map("otps")
}

enum OtpType {
    REGISTRATION_VERIFICATION
    LOGIN_VERIFICATION
    FORGOT_PASSWORD_VERIFICATION
}

model Country {
    id          Int     @id @default(autoincrement())
    name        String  @unique
    code        String  @unique // ISO country code like "IN", "US"
    flag        String? // URL or path to flag image
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt
    
    states      State[]
    users       User[]
    
    @@map("countries")
}

model State {
    id          Int     @id @default(autoincrement())
    name        String
    code        String? // State code like "MH", "KA"
    country_id  Int
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt
    
    country     Country @relation(fields: [country_id], references: [id], onDelete: Cascade)
    users       User[]
    
    @@unique([name, country_id])
    @@map("states")
}

model Language {
    id              Int     @id @default(autoincrement())
    name            String  @unique
    native_name     String? // Language name in its own script
    code            String  @unique // ISO 639-1 code like "hi", "en", "ne"
    country_code    String? // Associated country code
    is_active       Boolean @default(true)
    created_at      DateTime @default(now())
    updated_at      DateTime @updatedAt
    
    @@map("languages")
}


