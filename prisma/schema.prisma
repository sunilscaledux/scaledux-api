generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  FirstName         String
  LastName          String?
  email             String?   @unique
  phone             String?   @unique
  email_verified_at DateTime?
  phone_verified_at DateTime?
  password          String?
  status            Int       @default(1)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  notification      Boolean   @default(false)
  terms             Boolean   @default(true)
  googleId          String?   @unique
  linkedinId        String?   @unique
  profileImage      String?
  provider          String?
  coverImage        String?
  hideEmail         Boolean   @default(false)
  hidePhone         Boolean   @default(false)
  uniqueId          String    @unique
  otps              Otp[]
  personalInfo      PersonalInfo?

  @@index([email, phone])
  @@index([LastName, FirstName, email])
  @@index([googleId])
  @@index([linkedinId])
  @@map("users")
}

model PersonalInfo {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  title          String?
  about          String?
  address        String?
  address_line_2 String?
  city           String?
  website        String?
  zipCode        String?
  hourly_rate    Float?
  links          Json?
  currency_id    Int?
  country_id     Int?
  state_id       Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  currency       Currency? @relation(fields: [currency_id], references: [id])
  country        Country?  @relation(fields: [country_id], references: [id])
  state          State?    @relation(fields: [state_id], references: [id])

  @@map("personal_info")
}

model Otp {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  email      String?
  phone      String?
  otp_code   String
  otp_type   OtpType
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email, otp_type, verified])
  @@index([phone, otp_type, verified])
  @@index([expires_at])
  @@map("otps")
}

model Country {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  code         String         @unique
  flag         String?
  currency_id  Int?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  currency     Currency?      @relation(fields: [currency_id], references: [id])
  states       State[]
  personalInfo PersonalInfo[]

  @@map("countries")
}

model State {
  id           Int            @id @default(autoincrement())
  name         String
  code         String?
  country_id   Int
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  country      Country        @relation(fields: [country_id], references: [id], onDelete: Cascade)
  personalInfo PersonalInfo[]

  @@unique([name, country_id])
  @@map("states")
}

model Currency {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  code         String         @unique
  symbol       String
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  countries    Country[]
  personalInfo PersonalInfo[]

  @@map("currencies")
}

model Language {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  native_name  String?
  code         String   @unique
  country_code String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("languages")
}

enum OtpType {
  REGISTRATION_VERIFICATION
  LOGIN_VERIFICATION
  FORGOT_PASSWORD_VERIFICATION
}
