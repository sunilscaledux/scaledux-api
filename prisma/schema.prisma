  @@index([user_id, status])
  @@index([status])
  @@index([expertise_category_id])
  @@index([specialty_id])
  @@index([deleted_at])
  @@index([created_at])
  @@map("scd_founder_projects")
}

// Stores matched service providers for a project
model ProjectInvite {
  id                    Int       @id @default(autoincrement())
  project_id            Int
  provider_id           Int       // Freelancer user id
  message               String?   @db.Text
  main_reason           String?   @db.VarChar(50) // Predefined reason key when freelancer declines invitation
  status                String    @default("PENDING") @db.VarChar(20) // PENDING, ACCEPTED, REJECTED
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt
  
  project               FounderProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  provider              User @relation("ProjectInvites", fields: [provider_id], references: [id], onDelete: Cascade)

  @@unique([project_id, provider_id])
  @@index([project_id])
  @@index([provider_id])
  @@index([status])
  @@map("scd_project_invites")
}

// Service providers save projects they're interested in
model SavedProject {
  id                    Int       @id @default(autoincrement())
  project_id            Int
  user_id               Int       // Service provider user id
  created_at            DateTime  @default(now())
  
  project               FounderProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user                  User @relation("SavedProjects", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([project_id])
  @@index([user_id])
  @@map("scd_saved_projects")
}

model SavedMentor {
  id                    Int       @id @default(autoincrement())
  mentor_id             Int       // The mentor user id being saved
  user_id               Int       // The user who saved the mentor
  created_at            DateTime  @default(now())

  mentor                User @relation("SavedAsMentor", fields: [mentor_id], references: [id], onDelete: Cascade)
  user                  User @relation("SavedMentors", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([mentor_id, user_id])
  @@index([mentor_id])
  @@index([user_id])
  @@map("scd_saved_mentors")
}

model MentorOnRequest {
  id                      Int       @id @default(autoincrement())
  user_id                 Int       @unique
  is_available            Boolean   @default(false)
  session_frequency       Json?     // ["Daily","Weekly"] etc
  session_duration_min    Int?      // in minutes
  session_duration_max    Int?
  price_amount            Decimal?  @db.Decimal(10, 2)
  price_currency          String?   @default("INR") @db.VarChar(10)
  discount_enabled        Boolean   @default(false)
  discount_title          String?   @db.VarChar(200)
  discount_percent        Int?
  discount_available_till DateTime?
  recording_enabled       Boolean   @default(false)
  recording_type          String?   @db.VarChar(10) // "paid" | "free"
  recording_amount        Decimal?  @db.Decimal(10, 2)
  terms_and_conditions     String?   @db.Text
  default_meeting_provider String?   @db.VarChar(20) // "zoom" | "google_meet" | "ms_teams"
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_mentor_on_request")
}

model Availability {
  id               Int      @id @default(autoincrement())
  user_id          Int      @unique
  timezone         String   @default("Asia/Kolkata") @db.VarChar(50)
  /** JSON: [{ day: "monday", time: [{ from: "09:00", to: "17:00" }] }] */
  schedule         Json
  /** JSON: ["2026-04-20", "2026-04-25"] — dates user is unavailable */
  unavailability   Json?
  rest_break       Int?     // minutes between sessions (15, 30, 45, 60)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("scd_availability")
}

// Proposals submitted by service providers for founder projects
model Proposal {
  id                    Int       @id @default(autoincrement())
  unique_id             String    @unique @default(cuid())
  project_id            Int
  provider_id           Int       // Service provider user id
  status                String    @default("PENDING") @db.VarChar(20) // PENDING, SHORTLISTED, OFFER_SENT, OFFER_ACCEPTED, REJECTED, WITHDRAWN, HIRED, TERMINATING, TERMINATED
  /** When true, this row is a work-in-progress draft: hidden from the founder, not counted, no chat/invite side effects. Flipped to false when the provider hits Submit. */
  is_draft              Boolean   @default(false)
  
  // Proposal content
  cover_letter          String    @db.Text
  proposed_amount       Decimal   @db.Decimal(15, 2)
  payment_schedule      String    @db.VarChar(20) // byProject, byMilestone
  /** Freelancer’s estimated hours for the whole project (not per milestone). */
  hours_required        Int?
  screening_answers     Json      @default("[]") // Answers to screening questions
  attachments           Json      @default("[]") // File URLs
  /** Display message for founder (contextual, e.g. "You rejected…" or "[Name] withdrew…") */
  founder_remark        String?   @db.Text
  /** Predefined reason key from founder's action */
  founder_reason        String?   @db.VarChar(50)
  /** Display message for freelancer (contextual, e.g. "You withdrew…" or "Your proposal was rejected…") */
  freelancer_remark     String?   @db.Text
  /** Predefined reason key from freelancer's action */
  freelancer_reason     String?   @db.VarChar(50)

  // Lock milestones after hire (no more edit/delete)
  milestones_approved   Boolean   @default(false) // true when status becomes HIRED

  // Timestamps
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt
  /** When set, contract is scheduled to terminate at this time (1 week from user action). Only terminate_by can restore. */
  terminate_at          DateTime?
  /** User id who scheduled termination; only this user can restore. */
  terminate_by          Int?
  /** Set when every milestone became COMPLETED/PAID; starts the 48h project auto-completion window. */
  milestones_completed_at DateTime?

  // Relations
  project               FounderProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  provider              User @relation("UserProposals", fields: [provider_id], references: [id], onDelete: Cascade)
  milestonesRows       Milestone[]
  proposalNda           ProposalNda?   // NDA + offer: sent/signed/download timestamps and file links (1:1)

  @@unique([project_id, provider_id]) // One proposal per provider per project
  @@index([project_id])
  @@index([provider_id])
  @@index([status])
  @@map("scd_proposals")
}

// NDA and offer data per proposal (sent document, signed document, timestamps)
model ProposalNda {
  id                      Int       @id @default(autoincrement())
  proposal_id             Int       @unique
  /** When the offer expires (countdown from nda_sent_at + OFFER_EXPIRY_HOURS). */
  offer_expires_at        DateTime?
  /** True when freelancer has signed the NDA. */
  is_nda_signed           Boolean   @default(false)
  /** Attachment unique_id or path for the NDA document sent by founder. */
  nda_file_link           String?   @db.VarChar(512)
  /** When founder sent the NDA / offer. */
  nda_sent_at             DateTime?
  /** When freelancer signed the NDA. */
  nda_signed_at           DateTime?
  /** Attachment unique_id or path for the signed NDA uploaded by freelancer. */
  nda_signed_file_link    String?   @db.VarChar(512)
  /** When NDA was downloaded (founder or freelancer). */
  nda_downloaded_at      DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  proposal                Proposal  @relation(fields: [proposal_id], references: [id], onDelete: Cascade)

  @@map("scd_proposal_ndas")
}

// Polymorphic review: one row per public or private review (review_type). Used for contracts, mentor sessions, etc.
model Review {
  id              Int       @id @default(autoincrement())
  unique_id       String    @unique @default(cuid())

  review_from_id  Int       // User id of reviewer
  review_to_id    Int       // User id being reviewed
  action_type     String    @db.VarChar(50)   // e.g. PROPOSAL_CONTRACT, MENTOR_SESSION
  action_id       String    @db.VarChar(100)  // e.g. proposal unique_id

  review_type     String    @db.VarChar(20)  // PUBLIC | PRIVATE
  rating          Decimal   @db.Decimal(4, 2) // 0-10 private, 0-5 public overall
  feedback        String?   @db.Text
  end_reason      String?   @db.VarChar(255) // For PRIVATE; null for PUBLIC
  ratings_extra   Json?     // For PUBLIC category breakdown { skills, qualityOfWork, ... }; null for PRIVATE

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  review_from     User      @relation("ReviewsGiven", fields: [review_from_id], references: [id], onDelete: Cascade)
  review_to       User      @relation("ReviewsReceived", fields: [review_to_id], references: [id], onDelete: Cascade)

  @@unique([review_from_id, review_to_id, action_type, action_id, review_type])
  @@index([review_to_id, action_type])
  @@index([action_type, action_id])
  @@map("scd_reviews")
}

model ReportSpam {
  id                Int       @id @default(autoincrement())
  unique_id         String    @unique @default(cuid())
  reporter_id       Int
  reported_user_id  Int
  reason            String    @db.VarChar(255)
  description       String?   @db.Text
  status            String    @default("PENDING") @db.VarChar(20) // PENDING, REVIEWING, RESOLVED, CLOSED
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  reporter          User      @relation("ReportsGiven", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported_user     User      @relation("ReportsReceived", fields: [reported_user_id], references: [id], onDelete: Cascade)

  @@unique([reporter_id, reported_user_id])
  @@index([reported_user_id])
  @@map("scd_report_spam")
}

/// User-submitted bug reports: "steps to reproduce" text, auto-captured context
/// (page URL, browser, screen size) and an optional private screen+mic recording
/// (stored as an Attachment unique_id). Viewed/downloaded by admins in the panel.
model BugReport {
  id                         Int       @id @default(autoincrement())
  unique_id                  String    @unique @default(cuid())
  reporter_id                Int
  /** Free-text steps to reproduce written by the user. */
  steps                      String    @db.Text
  /** Page the user was on when reporting. */
  page_url                   String?   @db.VarChar(1024)
  /** Browser user-agent string (auto-captured). */
  user_agent                 String?   @db.Text
  /** Viewport/screen size, e.g. "1920x1080" (auto-captured). */
  screen_size               String?   @db.VarChar(32)
  /** Attachment.unique_id of the private screen+mic recording, if provided. */
  recording_attachment_id    String?   @db.VarChar(36)
  /** Recording length in seconds, if a recording was attached. */
  recording_duration_seconds Int?
  status                     String    @default("OPEN") @db.VarChar(20) // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  /** Internal note written by an admin while triaging. */
  admin_note                 String?   @db.Text
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  reporter                   User      @relation("BugReportsGiven", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@index([reporter_id])
  @@index([status])
  @@index([created_at])
  @@map("scd_bug_reports")
}

model ContactSubmission {
  id          Int      @id @default(autoincrement())
  unique_id   String   @unique @default(cuid())
  first_name  String   @db.VarChar(20)
  last_name   String   @db.VarChar(20)
  email       String   @db.VarChar(255)
  phone       String   @db.VarChar(20)
  /** Reason bucket chosen in the form: question, sales, support, other. */
  reason      String   @db.VarChar(20)
  subject     String   @db.VarChar(100)
  message     String   @db.Text
  status      String   @default("NEW") @db.VarChar(20) // NEW, IN_PROGRESS, RESOLVED, ARCHIVED
  /** Internal note written by an admin while triaging. */
  admin_note  String?  @db.Text
  /** Origin IP, captured for abuse tracing. */
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([status])
  @@index([created_at])
  @@map("scd_contact_submissions")
}

model BlockedUser {
  id              Int       @id @default(autoincrement())
  blocker_id      Int
  blocked_user_id Int
  created_at      DateTime  @default(now())

  blocker       User @relation("BlockedByUser", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked_user  User @relation("BlockedTargetUser", fields: [blocked_user_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_user_id])
  @@index([blocked_user_id])
  @@map("scd_blocked_users")
}

// Milestones linked to project and proposal (enables per-milestone docs and status)
model Milestone {
  id               Int       @id @default(autoincrement())
  unique_id        String    @unique @default(cuid())
  project_id       Int
  proposal_id      Int
  order_index      Int       @default(0)   // 0-based order within proposal
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  amount           Decimal   @db.Decimal(15, 2)
  due_date         DateTime? @db.Date
  hours_required   Int?
  status           String    @default("PENDING") @db.VarChar(20) // Milestone completion: PENDING, IN_PROGRESS, COMPLETED, PAID (exposed as milestone_status in API)
  payment_status   String    @default("PENDING") @db.VarChar(20) // PENDING, FUNDED, RELEASED
  /** Platform service fee (amount) deducted when payment was released; set on release. */
  service_fee_amount Decimal? @db.Decimal(10, 2)
  /** When true, this milestone cannot be edited/deleted (e.g. set when proposal is HIRED or milestone approved) */
  is_approved      Boolean   @default(false)
  /** Client/founder message (e.g. note when approving or general remark) */
  remark           String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  project   FounderProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  proposal  Proposal        @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  deliverablesRow Deliverable[]
  billingTransactions BillingTransaction[]

  @@unique([proposal_id, order_index])
  @@index([project_id])
  @@index([proposal_id])
  @@map("scd_milestones")
}

// Per-deliverable work submission (one row per deliverable within a milestone)
// Documents stored per deliverable in submitted_file; feedback stored when founder requests changes
model Deliverable {
  id                Int       @id @default(autoincrement())
  unique_id         String    @unique @default(cuid())
  milestone_id      Int
  order_index      Int       @default(0)   // 0-based within milestone
  description       String    @db.VarChar(500)
  status            String    @default("PENDING") @db.VarChar(20) // PENDING | SUBMITTED | CHANGES_REQUESTED | APPROVED
  submitted_at      DateTime? @db.Timestamptz
  submitted_remark  String?   @db.Text
  submitted_file    Json      @default("[]")    // Array of { url, name }
  approved_at       DateTime? @db.Timestamptz   // When founder approved this deliverable
  feedback          String?   @db.Text           // Founder's message when requesting changes; cleared on resubmit
  revision_count    Int       @default(0)         // How many times the founder requested changes (max 10)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  milestone Milestone @relation(fields: [milestone_id], references: [id], onDelete: Cascade)

  @@unique([milestone_id, order_index])
  @@index([milestone_id])
  @@map("scd_deliverables")
}

// Chat: one conversation per user pair (user1, user2)
model Conversation {
  id                    Int       @id @default(autoincrement())
  unique_id             String    @unique @default(cuid())
  user1_id              Int       // smaller user id for consistent lookup
  user2_id              Int       // larger user id
  status                String?   @db.VarChar(20) // NOT_ACCEPTED | ACCEPTED | BLOCKED; null = no restriction
  blocked_by_user_id    Int?      // user who blocked (only they can unblock); null when not blocked
  user1_has_new_message Boolean   @default(false) // true when user1 has unread messages
  user2_has_new_message Boolean   @default(false) // true when user2 has unread messages
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  user1    User     @relation("ConversationUser1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2    User     @relation("ConversationUser2", fields: [user2_id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1_id, user2_id])
  @@index([user1_id, user2_id])
  @@map("scd_conversations")
}

model Message {
  id              Int       @id @default(autoincrement())
  unique_id       String    @unique @default(cuid())
  conversation_id Int
  sender_id       Int?      // null for system messages
  type            String    @db.VarChar(20) // USER | SYSTEM
  content         String    @db.Text
  metadata        Json?     // e.g. { activityType, projectId, proposalId }
  created_at      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [sender_id], references: [id], onDelete: SetNull)

  @@index([conversation_id, created_at])
  @@map("scd_messages")
}

