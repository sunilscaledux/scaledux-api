# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/scaledux_db"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration (SMTP / Nodemailer)
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=noreply@scaledux.com
SMTP_FROM_NAME=ScaleDux

# Email layout (footer and brand name). COMPANY_NAME falls back to APP_NAME if unset
COMPANY_NAME=ScaleDux
EMAIL_FOOTER_MESSAGE=Best regards,
EMAIL_FOOTER_NOTE=This is an automated email. Please do not reply to this message.

# Optional: base URL for links in emails (e.g. notification "View details")
APP_URL=http://localhost:3000

# Application Configuration
APP_NAME="ScaleDux"
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Rate Limiting
ENABLE_RATE_LIMITING=true

# Offer expiry (hours) – countdown starts when NDA is sent; default 24
OFFER_EXPIRY_HOURS=24

# Pagination defaults
PROPOSAL_PAGE_LIMIT=50
BILLING_PAGE_LIMIT=10
FOUNDER_PROJECT_PAGE_LIMIT=20
FOUNDER_PROJECT_PROVIDERS_PAGE_LIMIT=10

# Minimum profile completion percentage required to submit a proposal or send a connection request (default: 90)
MIN_PROFILE_COMPLETION_PERCENT=90
MIN_PROJECT_BUDGET=500

# Commission deducted from freelancer payout (default: 10%)
SERVICE_FEE_PERCENT=10

# Platform fee charged to founder: "flat" (fixed INR) or "percentage" (% of milestone)
PLATFORM_FEE_TYPE=flat
PLATFORM_FEE_AMOUNT=0

# Processing fee deducted from freelancer payout (default: 1.5%)
PROCESSING_FEE_PERCENT=1.5

# TCS rate — only applied if provider is GST registered (default: 0.5%)
TCS_PERCENT=0.5

# GST percent applied on all fees (default: 18)
GST_PERCENT=18

# @deprecated — use PLATFORM_FEE_TYPE + PLATFORM_FEE_AMOUNT instead
APP_FEE_FOUNDER=100

DEACTIVATION_GRACE_DAYS=7

FILES_DISK=local

BUNNY_PUBLIC_STORAGE_ZONE=
BUNNY_PUBLIC_STORAGE_API_KEY=
BUNNY_PUBLIC_STORAGE_HOST=
BUNNY_PRIVATE_STORAGE_ZONE=
BUNNY_PRIVATE_STORAGE_API_KEY=
BUNNY_PRIVATE_STORAGE_HOST=
BUNNY_CDN_HOSTNAME=your-pull-zone.b-cdn.net


# Razorpay
RAZORPAY_KEY_ID=''
RAZORPAY_KEY_SECRET=''
RAZORPAY_X_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_PLATFORM_ACCOUNT_ID=
RAZORPAY_WEBHOOK_SECRET=

IDENTITY_VERIFICATION_COOLDOWN_DAYS=15
AGENCY_VERIFICATION_COOLDOWN_DAYS=15

# MSG91 SMS OTP
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_OTP_TEMPLATE_ID=your-msg91-template-id

# MSG91 WhatsApp OTP
MSG91_WHATSAPP_TEMPLATE_NAME=your-msg91-whatsapp-template-name
MSG91_WHATSAPP_INTEGRATED_NUMBER=your-msg91-whatsapp-integrated-number

# IDtoAI PAN, GSTIN & DigiLocker Verification (https://idtoai.readme.io/)
IDTOAI_API_KEY=your-idtoai-api-key
IDTOAI_CLIENT_ID=your-idtoai-client-id
IDTOAI_BASE_URL=https://prod.idto.ai/verify

# Zoom OAuth (https://marketplace.zoom.us/develop/apps)
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# Microsoft Teams / Azure AD (https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps)
MS_TEAMS_CLIENT_ID=your-ms-teams-client-id
MS_TEAMS_CLIENT_SECRET=your-ms-teams-client-secret

