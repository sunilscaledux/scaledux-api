# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/scaledux_db"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration (ZeptoMail)
ZEPTO_URL=https://api.zeptomail.in/
ZEPTO_TOKEN=your-zeptomail-token
ZEPTO_FROM_EMAIL=noreply@scaledux.com
ZEPTO_FROM_NAME=ScaleDux

# Email layout (footer and brand name). COMPANY_NAME falls back to APP_NAME if unset
COMPANY_NAME=ScaleDux
EMAIL_FOOTER_MESSAGE=Best regards,
EMAIL_FOOTER_NOTE=This is an automated email. Please do not reply to this message.

# Optional: base URL for links in emails (e.g. notification "View details")
APP_URL=http://localhost:3000

# Application Configuration
APP_NAME="ScaleDux"
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Rate Limiting
ENABLE_RATE_LIMITING=true

# Offer expiry (hours) – countdown starts when NDA is sent; default 24
OFFER_EXPIRY_HOURS=24

# Pagination defaults
PROPOSAL_PAGE_LIMIT=50
BILLING_PAGE_LIMIT=10
FOUNDER_PROJECT_PAGE_LIMIT=20
FOUNDER_PROJECT_PROVIDERS_PAGE_LIMIT=10

# Minimum profile completion percentage required to submit a proposal (default: 50)
MIN_PROFILE_COMPLETION_PERCENT=50

# Platform service fee (percent) deducted from freelancer when founder releases payment (default: 10)
SERVICE_FEE_PERCENT=10
